{
  "name": "Eens Business Park",
  "short_name": "Eens",
  "lang": "en-KE",
  "dir": "ltr",
  "description": "Published property listings, locations, and leasing information from Eens Limited.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "background_color": "#0f172a",
  "theme_color": "#fafaf9",
  "categories": ["business", "real estate"],
  "icons": [
    {
      "src": "/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/home-page.png",
      "sizes": "1289x947",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Home page showing search and featured listings"
    }
  ],
  "shortcuts": [
    {
      "name": "Shop units",
      "short_name": "Shops",
      "description": "Browse published shop units.",
      "url": "/shops",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Warehouses",
      "short_name": "Warehouses",
      "description": "Browse published warehouse listings.",
      "url": "/warehouses",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Eens Business Park",
      "short_name": "Business Park",
      "description": "Open the Syokimau park overview.",
      "url": "/business-parks/eens",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Contact Eens",
      "short_name": "Contact",
      "description": "Arrange a viewing or ask about availability.",
      "url": "/contact",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
