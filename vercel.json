{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/properties",
      "destination": "/locations",
      "permanent": true
    },
    {
      "source": "/properties/mlolongo-warehouse",
      "destination": "/warehouses/mlolongo-warehouse",
      "permanent": true
    },
    {
      "source": "/properties/mlolongo-logistics-hub",
      "destination": "/warehouses/mlolongo-logistics-hub",
      "permanent": true
    },
    {
      "source": "/properties/syokimau-godown",
      "destination": "/godowns/syokimau-godown",
      "permanent": true
    },
    {
      "source": "/properties/baba-dogo-business-park",
      "destination": "/business-parks/baba-dogo-business-park",
      "permanent": true
    },
    {
      "source": "/properties/flame-tree-3bed",
      "destination": "/apartments/flame-tree-3bed",
      "permanent": true
    },
    {
      "source": "/properties/:slug",
      "destination": "/locations",
      "permanent": true
    }
  ],
  "buildCommand": "export NODE_OPTIONS=--max-old-space-size=6144; node scripts/smoke-env.mjs || exit 1; pnpm run audit || exit 1; pnpm build:cloud || exit 1; pnpm build:search || echo 'warning: search index sync failed (non-fatal) -- see Vercel build log'"
}
