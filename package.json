{
  "name": "eensbpark",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "tinacms dev --datalayer-port 9106 -c \"astro dev\"",
    "build": "export NODE_OPTIONS=${NODE_OPTIONS:-\"--max-old-space-size=4096\"} && tinacms build --datalayer-port 9106 && astro build",
    "build:local": "tinacms build --datalayer-port 9106 --local --skip-cloud-checks -c \"astro build\"",
    "build:cloud": "tinacms build --datalayer-port 9106 -c \"astro build\"",
    "build:search": "tinacms search-index",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "astro preview",
    "preview:background": "astro preview --background",
    "preview:status": "astro preview status",
    "preview:logs": "astro preview logs",
    "preview:stop": "astro preview stop",
    "astro": "astro",
    "prebuild": "node scripts/smoke-env.mjs && node scripts/audit-guard.mjs",
    "smoke:env": "node scripts/smoke-env.mjs",
    "audit:content-sync": "node scripts/audit-content-sync.mjs",
    "audit:pwa": "node scripts/audit-pwa.mjs",
    "audit:vercel-output": "node scripts/audit-vercel-output.mjs",
    "audit": "pnpm audit --prod --audit-level=critical",
    "audit:cycle": "node scripts/audit-cycle.mjs",
    "lint:wrappers": "node scripts/lint-wrappers.mjs",
    "verify": "pnpm run lint:wrappers && pnpm run audit:content-sync && pnpm run audit:pwa && pnpm run audit:vercel-output && pnpm exec astro check && pnpm test",
    "install:hooks": "node scripts/setup-hooks.mjs",
    "ci:vercel": "node scripts/replicate-vercel-build.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.5",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@iconify-json/tabler": "^1.2.35",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tinacms/astro": "^0.6.1",
    "astro": "^7.2.0",
    "astro-icon": "^1.1.5",
    "clsx": "^2.1.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tinacms/cli": "^2.5.6",
    "@types/node": "^25.9.1",
    "astro-mcp": "^0.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tinacms": "^3.11.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.9"
  }
}
