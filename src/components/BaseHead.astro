---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = '/photography/pexels-photo-9716363.jpeg' } = Astro.props;
const imageURL = new URL(image, Astro.url).toString();
const descriptionText = description || 'Published property listings, locations, and leasing information from Eens Limited.';
---

<script is:inline>
	(function () {
		function isDark() {
			try {
				const stored = localStorage.getItem('theme');
				return stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
			} catch (e) {
				return false;
			}
		}
		function apply() {
			document.documentElement.classList.toggle('dark', isDark());
			document.documentElement.classList.add('js');
		}
		function reveal() {
			const elements = document.querySelectorAll('.reveal-on-scroll');
			if (!elements.length) return;
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || typeof IntersectionObserver === 'undefined') {
				elements.forEach((element) => element.classList.add('is-visible'));
				return;
			}
			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				});
			}, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
			elements.forEach((element) => {
				if (!element.classList.contains('is-visible')) observer.observe(element);
			});
		}
		apply();
		if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', reveal, { once: true });
		else reveal();
		// ClientRouter swaps in the SSR'd <html> (no .dark) on navigation,
		// so re-apply the persisted theme and bind new page reveals.
		document.addEventListener('astro:after-swap', apply);
		document.addEventListener('astro:page-load', reveal);
	})();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Tina Cloud rewrites media URLs to assets.tina.io in production; warm the connection. -->
<link rel="preconnect" href="https://assets.tina.io" crossorigin />
<link rel="dns-prefetch" href="https://assets.tina.io" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={descriptionText} />
<meta name="theme-color" content="#fafaf9" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Eens Limited" />
<meta property="og:locale" content="en_KE" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={descriptionText} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={title} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={descriptionText} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={title} />

<!-- TinaCMS visual editing is wired by the tina() integration in astro.config.mjs; its middleware only touches edit-mode responses, so there's nothing to add here. -->

<ClientRouter />
