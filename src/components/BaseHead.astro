---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { cloudinaryUrl } from '../lib/cloudinary';

// Preload the two latin display/body font subsets so first paint is not
// blocked on font discovery. Stable URLs from public/fonts/ (the latin
// subsets of the pinned @fontsource packages, copied at build source).
const interLatin = '/fonts/inter-latin.woff2';
const pjsLatin = '/fonts/plus-jakarta-sans-latin.woff2';

interface Props {
	title: string;
	description: string;
	image?: string;
	/** Header logo URL (the fixed header logo is the first-paint candidate). */
	logo?: string | null;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = '/photography/pexels-photo-9716363.jpeg', logo = null } = Astro.props;
const imageURL = new URL(cloudinaryUrl(image) ?? image, Astro.url).toString();
const descriptionText = description || 'Published property listings, locations, and leasing information from Eens Limited.';
const breadcrumbLabels: Record<string, string> = {
	'about': 'About Eens',
	'awards': 'Awards and accolades',
	'blog': 'News',
	'business-parks': 'Business parks',
	'contact': 'Contact',
	'careers': 'Careers',
	'events': 'Events',
	'gallery': 'Gallery',
	'lease-terms': 'Lease terms',
	'locations': 'Locations',
	'shops': 'Shop units',
	'warehouses': 'Warehouses',
	'godowns': 'Godowns',
	'apartments': 'Apartments',
	'upcoming-projects': 'Upcoming projects',
};
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
	{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
	...pathSegments.map((segment, index) => ({
		'@type': 'ListItem',
		position: index + 2,
		name: breadcrumbLabels[segment] ?? decodeURIComponent(segment).replace(/[-_]/g, ' '),
		...(index === pathSegments.length - 1 ? {} : { item: new URL(`/${pathSegments.slice(0, index + 1).join('/')}`, Astro.site).toString() }),
	})),
];
const breadcrumbJson = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: breadcrumbItems,
};
const breadcrumbJsonText = JSON.stringify(breadcrumbJson).replace(/</g, '\\u003c');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<script is:inline>
	(function () {
		function isDark() {
			try {
				const stored = localStorage.getItem('theme');
				return stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
			} catch (e) {
				return false;
			}
		}
		function apply() {
			document.documentElement.classList.toggle('dark', isDark());
			document.documentElement.classList.add('js');
		}
		function reveal() {
			const elements = document.querySelectorAll('.reveal-on-scroll');
			if (!elements.length) return;
			// Reveal-on-scroll must never hide above-the-fold content from the
			// first paint (LCP). Only elements already below the viewport get
			// the hidden state; the rest stay visible with no transition.
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || typeof IntersectionObserver === 'undefined') {
				return;
			}
			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				});
			}, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
			elements.forEach((element) => {
				if (element.classList.contains('is-visible')) return;
				const rect = element.getBoundingClientRect();
				if (rect.top > window.innerHeight) {
					element.setAttribute('data-reveal', 'below-fold');
					observer.observe(element);
				}
			});
		}
		apply();
		if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', reveal, { once: true });
		else reveal();
		if ('serviceWorker' in navigator && window.isSecureContext) {
			const registerServiceWorker = () => {
				void navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => undefined);
			};
			if (document.readyState === 'loading') window.addEventListener('load', registerServiceWorker, { once: true });
			else registerServiceWorker();
		}
	})();
</script>

<!-- Preload the two body/display font subsets used in the first viewport. -->
<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="preload" href={pjsLatin} as="font" type="font/woff2" crossorigin="anonymous" />
<!-- The fixed header logo is the first-paint candidate on every page. -->
{logo && <link rel="preload" as="image" href={logo} fetchpriority="high" />}

<!-- Global Metadata -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="Eens" />
<link rel="apple-touch-startup-image" media="(device-width: 430px) and (device-height: 932px) and (-webkit-device-pixel-ratio: 3)" href="/splash-1290x2796.png" />
<link rel="apple-touch-startup-image" media="(device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3)" href="/splash-1170x2532.png" />
<link rel="apple-touch-startup-image" media="(device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2)" href="/splash-750x1334.png" />
<link rel="apple-touch-startup-image" media="(device-width: 1024px) and (device-height: 1366px) and (-webkit-device-pixel-ratio: 2)" href="/splash-2048x2732.png" />
<meta name="generator" content={Astro.generator} />

<!-- Tina Cloud rewrites media URLs to assets.tina.io in production; warm the connection. -->
<link rel="preconnect" href="https://assets.tina.io" crossorigin />
<link rel="dns-prefetch" href="https://assets.tina.io" />
<!-- All content images (hero, cards, galleries) serve from Cloudinary; warm the
     connection so the first (LCP) image doesn't pay a DNS+TCP+TLS round-trip. -->
<link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
<link rel="dns-prefetch" href="https://res.cloudinary.com" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={descriptionText} />
<meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />

<script is:inline type="application/ld+json" set:html={breadcrumbJsonText}></script>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Eens Limited" />
<meta property="og:locale" content="en_KE" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={descriptionText} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={title} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={descriptionText} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={title} />

<!-- TinaCMS visual editing is wired by the tina() integration in astro.config.mjs; its middleware only touches edit-mode responses, so there's nothing to add here. -->
