---
import Icon from './ui/Icon.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsConfig, CmsConfigContactLink } from '../lib/data';
import { contactEmail } from '../lib/data';
import Button from './ui/Button.astro';
import IconLink from './IconLink.astro';
import { isCurrentPath } from '../lib/path';

// Use the shared public glyph so the footer and header keep one logo source.
const EensGlyph = '/eens-glyph.svg';

interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const seo = config?.seo ?? null;
const contactLinks = (config?.contactLinks ?? []).filter(
	(item): item is CmsConfigContactLink => item !== null,
);
const viewingSubject = encodeURIComponent('Schedule a viewing');
// Single source of truth: contactEmail() (see src/lib/data.ts) reads
// config.seo.email and falls back to CONTACT_DEFAULTS.email so the build
// is safe even before Tina regen picks up the Phase 19 schema additions.
const viewingHref = `mailto:${contactEmail(config)}?subject=${viewingSubject}`;
const today = new Date();
const sinceYear = 2018;

const spaceLinks = [
	{ title: 'Shop units', href: '/shops' },
	{ title: 'Warehouses', href: '/warehouses' },
	{ title: 'Godowns', href: '/godowns' },
	{ title: 'Apartments', href: '/apartments' },
	{ title: 'Locations', href: '/locations' },
];
const directoryLinks = [
	{ title: 'Eens Business Park', href: '/business-parks/eens' },
	{ title: 'Tenant profiles', href: '/contact' },
	{ title: 'About Eens', href: '/about' },
];
const informationLinks = [
	{ title: 'Lease terms', href: '/lease-terms' },
	{ title: 'Journal', href: '/blog' },
	{ title: 'Contact Eens', href: '/contact' },
];
---

<footer
	class="relative overflow-hidden border-t-2 border-primary-dark/70 bg-canvas-dark text-ink-dark"
>
	<div class="relative mx-auto max-w-6xl px-6 pt-section pb-12">
		<div class="grid gap-12 lg:grid-cols-[1fr_2fr]">
			<!-- Identity block: glyph + wordmark + tagline + CTA -->
			<div>
				<p class="mb-4 font-mono text-[11px] font-medium uppercase tracking-[0.5px] text-primary-dark">EENS PROPERTY REGISTER</p>
				<div class="flex items-center gap-3">
					<img src={EensGlyph} alt="" aria-hidden="true" class="size-7" />
					<span class="font-display text-2xl font-semibold tracking-[-0.6px] text-ink-dark">
						Eens Business Park
					</span>
				</div>
				<p class="mt-5 max-w-md text-pretty font-mono text-[13px] leading-relaxed text-ink-dark/80">
					Published industrial and residential listings across Mlolongo, Syokimau, Baba Dogo, and Thika.
				</p>
				<p class="mt-3 max-w-md text-pretty text-sm text-ink-dark/60">
					Listings show the address, area, price or rate, availability, and terms. Viewings are by appointment.
				</p>
				<a href="/business-parks/eens" class="mt-6 block max-w-md rounded-lg border border-primary-dark/40 bg-canvas-dark/60 p-4 transition-[border-color,transform] duration-200 hover:-translate-y-px hover:border-primary-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-dark/70">
					<span class="font-mono text-[11px] font-medium uppercase tracking-[0.4px] text-primary-dark">Featured location</span>
					<span class="mt-1 block font-display text-lg font-medium text-ink-dark">Eens Business Park, Syokimau</span>
					<span class="mt-1 block text-sm text-ink-dark/60">Open the park overview and published shop register.</span>
				</a>
				<div class="mt-4">
					<Button href={viewingHref} variant="inverse" size="lg">
						<Icon name="calendar" class="size-4" />
						<span>Schedule a viewing</span>
					</Button>
				</div>
			</div>

			<!-- Link grid: 3 columns at lg, stacked at sm -->
			<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
				<section aria-label="Property types">
					<h3 class="text-[13px] font-medium uppercase tracking-[0.4px] text-ink-dark/70">
						Property types
					</h3>
					<ul class="mt-4 space-y-2 text-sm">
				{spaceLinks.map((l) => (
					<li>						<a href={l.href} aria-current={isCurrentPath(Astro.url.pathname, l.href) ? 'page' : undefined} class="inline-flex min-h-10 items-center text-ink-dark/80 transition-[color,transform] duration-200 ease-out hover:translate-x-0.5 hover:text-ink-dark aria-[current=page]:text-ink-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-dark/70">
									{l.title}
								</a>
							</li>
						))}
					</ul>
				</section>

				<section aria-label="Park directory">
					<h3 class="text-[13px] font-medium uppercase tracking-[0.4px] text-ink-dark/70">
						Park directory
					</h3>
					<ul class="mt-4 space-y-2 text-sm">
				{directoryLinks.map((l) => (
					<li>
						<a
							href={l.href}
							aria-current={isCurrentPath(Astro.url.pathname, l.href) ? "page" : undefined}
							class="inline-flex min-h-10 items-center text-ink-dark/80 transition-[color,transform] duration-200 ease-out hover:translate-x-0.5 hover:text-ink-dark aria-[current=page]:text-ink-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-dark/70"
						>
									{l.title}
								</a>
							</li>
						))}
					</ul>
				</section>

				<section aria-label="Information">
					<h3 class="text-[13px] font-medium uppercase tracking-[0.4px] text-ink-dark/70">
						Information
					</h3>
					<ul class="mt-4 space-y-2 text-sm">
						{informationLinks.map((l) => (
							<li>
								<a href={l.href} aria-current={isCurrentPath(Astro.url.pathname, l.href) ? 'page' : undefined} class="inline-flex min-h-10 items-center text-ink-dark/80 transition-[color,transform] duration-200 ease-out hover:translate-x-0.5 hover:text-ink-dark aria-[current=page]:text-ink-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-dark/70">
									{l.title}
								</a>
							</li>
						))}							</ul>
				</section>

				<section aria-label="Contact">
					<h3 class="text-[13px] font-medium uppercase tracking-[0.4px] text-ink-dark/70">Contact</h3>
					<ul class="mt-4 space-y-2 text-sm">
						{contactLinks.map((link) => (
							<li>
								<IconLink title={link.title} link={link.link} icon={link.icon} data-tina-field={tinaField(link, 'title')} />
							</li>
						))}
						<li class="font-mono text-[13px] text-ink-dark/60">Replies within one business day.</li>
					</ul>
				</section>
			</div>
		</div>

		<!-- Hairline divider closing the link grid -->
		<div class="mt-16 h-px w-full bg-hairline-steel/30" aria-hidden="true"></div>

		<!-- Bottom strip: copyright and operating history -->
		<div class="mt-6 flex flex-col items-center justify-between gap-4 text-xs text-ink-dark/60 sm:flex-row">
			<p class="font-mono">
				© {today.getFullYear()}
				<span data-tina-field={seo ? tinaField(seo, 'siteOwner') : undefined}>{seo?.siteOwner}</span>
				. Operating since {sinceYear}.
			</p>
			<span class="font-mono text-[13px] text-ink-dark/60">Mlolongo / Syokimau / Baba Dogo / Thika</span>
		</div>
	</div>
</footer>
