---
import Icon from './ui/Icon.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsConfig } from '../lib/data';
import IconLink from './IconLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { contactEmail } from '../lib/data';
import { isCurrentPath } from '../lib/path';

interface Props {
	config?: CmsConfig | null;
}

type MenuItem = {
	label: string;
	href: string;
	detail?: string;
	icon?: string;
};

type MenuGroup = {
	label: string;
	href: string;
	linkLabel: string;
	intro: string;
	items: MenuItem[];
};

const { config } = Astro.props;
const seo = config?.seo ?? null;
const contactLinks = (config?.contactLinks ?? []).filter(item => item !== null);
const viewingHref = `mailto:${contactEmail(config)}?subject=${encodeURIComponent('Schedule a viewing')}`;
const configuredNav = (config?.nav ?? []).filter((item) => item !== null);
const groupHref = (group: MenuGroup): string =>
	configuredNav.find((item) => item.title === group.label)?.link ?? group.href;
const groupIsCurrent = (group: MenuGroup): boolean =>
	group.items.some((item) => item.href.startsWith('/') && isCurrentPath(Astro.url.pathname, item.href));

// Keep the menu tied to pages and actions that exist in this repository.
// This is an operational directory, not a list of fictional tenant systems.
const menuGroups: MenuGroup[] = [
	{
		label: 'Explore',
		href: '/locations',
		linkLabel: 'Browse locations',
		intro: 'Find a published space across the Eens portfolio.',
		items: [
			{ label: 'Shop units', href: '/shops', detail: 'Available retail and commercial spaces', icon: 'building-store' },
			{ label: 'Warehouses', href: '/warehouses', detail: 'Published industrial specifications', icon: 'building-warehouse' },
			{ label: 'Godowns', href: '/godowns', detail: 'Storage and distribution space', icon: 'package' },
			{ label: 'Apartments', href: '/apartments', detail: 'Published prices and sale terms', icon: 'building' },
		],
	},
	{
		label: 'Browse the park',
		href: '/locations',
		linkLabel: 'View locations',
		intro: 'Understand where the portfolio operates.',
		items: [
			{ label: 'Eens Business Park', href: '/business-parks/eens', detail: 'Named park overview in Syokimau', icon: 'building-community' },
			{ label: 'Tenant profiles', href: '/contact', detail: 'Ask about verified businesses at Eens', icon: 'file-text' },
			{ label: 'Browse by location', href: '/locations', detail: 'Mlolongo, Syokimau, Baba Dogo, Thika', icon: 'map-pin' },
			{ label: 'About Eens', href: '/about', detail: 'How the portfolio is published', icon: 'file-text' },
			{ label: 'Careers', href: '/careers', detail: 'Published roles and applications', icon: 'briefcase' },
		],
	},
	{
		label: 'Visit',
		href: '/locations',
		linkLabel: 'Arrange a viewing',
		intro: 'Take the next step with a listing reference.',
		items: [
			{ label: 'Arrange a viewing', href: viewingHref, detail: 'Email the Eens office', icon: 'calendar' },
			{ label: 'Lease terms', href: '/lease-terms', detail: 'Published lease and sale terms', icon: 'file-text' },
			{ label: 'Contact Eens', href: '/contact', detail: 'Office details and questions', icon: 'phone' },
		],
	},
	{
		label: 'Journal',
		href: '/blog',
		linkLabel: 'Read the journal',
		intro: 'Practical notes on locations, specifications, and leasing.',
		items: [
			{ label: 'News', href: '/blog', detail: 'Read the latest Eens updates', icon: 'book-2' },
			{ label: 'Events', href: '/events', detail: 'Published events and viewing days', icon: 'calendar-event' },
			{ label: 'Gallery', href: '/gallery', detail: 'Project material and visual context', icon: 'photo' },
			{ label: 'Awards and accolades', href: '/awards', detail: 'Published recognition and evidence', icon: 'award' },
			{ label: 'Warehouse specifications', href: '/blog/reading-warehouse-spec-sheets', detail: 'How to read a spec sheet', icon: 'ruler' },
		],
	},
];
---

<header class="fixed top-0 z-20 w-full border-b border-hairline-steel/50 bg-background backdrop-blur-md supports-[backdrop-filter]:bg-background/75">
	<nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-3" aria-label="Primary navigation">
		<a href="/" class="flex min-w-max items-center gap-3 font-display font-semibold text-foreground" data-tina-field={seo ? tinaField(seo, 'title') : undefined}>
			<img src={seo?.logo ?? '/logo-enns.png'} alt="Eens Limited" width="76" height="28" decoding="sync" fetchpriority="high" class="h-7 w-auto dark:invert" data-tina-field={seo?.logo ? tinaField(seo, 'logo') : undefined} />
		</a>

		<div class="hidden items-center gap-1 xl:flex">
			{menuGroups.map((group) => (
				<details class="group relative">
					<summary class:list={["flex min-h-10 cursor-pointer list-none items-center gap-1.5 rounded-md px-3 text-sm text-muted-foreground transition-[background-color,color] hover:bg-accent hover:text-foreground group-open:bg-accent group-open:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 [&::-webkit-details-marker]:hidden", groupIsCurrent(group) && 'text-foreground']}>
						<span>{group.label}</span>
						<Icon name="chevron-down" class="size-3.5 transition-transform duration-200 group-open:rotate-180" />
					</summary>
					<div class="mega-panel glass z-30 rounded-2xl text-card-foreground shadow-2xl shadow-canvas-dark/10 ring-1 ring-foreground/5">
						<div class="accent-hairline h-px w-full" aria-hidden="true"></div>
						<div class="grid gap-5 p-3 lg:grid-cols-[minmax(12rem,0.85fr)_minmax(0,1.5fr)] lg:gap-6 lg:p-4">
							<div class="flex flex-col rounded-xl border border-hairline-steel/50 bg-secondary/50 px-4 pb-4 pt-4 lg:border-r lg:border-hairline-steel/60">
								<p class="font-mono text-[11px] font-medium uppercase tracking-[0.4px] text-primary">{group.label}</p>
								<p class="mt-2 max-w-xs text-sm leading-relaxed text-muted-foreground">{group.intro}</p>
								<a href={groupHref(group)} class="mt-4 inline-flex min-h-10 items-center gap-1.5 text-sm font-medium text-primary transition-colors hover:text-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">
									<span>{group.linkLabel}</span>
									<Icon name="arrow-up-right" class="size-3.5" />
								</a>
								<a href="/business-parks/eens" class="group/park mt-auto hidden min-w-0 rounded-lg border border-hairline-steel/50 bg-canvas-dark p-3 text-ink-dark transition-[border-color,transform] duration-200 hover:-translate-y-px hover:border-primary-dark/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-dark/70 lg:block">
									<span class="font-mono text-[10px] font-medium uppercase tracking-[0.4px] text-primary-dark">Featured park</span>
									<span class="mt-1 flex min-w-0 items-center justify-between gap-2 font-display text-sm font-medium text-ink-dark">
										<span class="min-w-0 break-words">Eens Business Park, Syokimau</span>
										<Icon name="arrow-up-right" class="size-3.5 shrink-0 transition-transform duration-200 group-hover/park:translate-x-0.5" />
									</span>
									<span class="mt-0.5 block text-xs leading-relaxed text-ink-dark/70">Park overview and published shop register.</span>
								</a>
							</div>
							<div class="grid gap-1 sm:grid-cols-2">
								{group.items.map((item) => (
									<a href={item.href} class:list={["group/item flex min-h-14 items-start gap-3 rounded-lg border border-transparent p-3 transition-[background-color,border-color,transform] duration-200 hover:-translate-y-px hover:border-hairline-steel/60 hover:bg-secondary aria-[current=page]:border-primary/60 aria-[current=page]:bg-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50", item.href === '/business-parks/eens' && 'bg-secondary/60']} aria-current={isCurrentPath(Astro.url.pathname, item.href) ? 'page' : undefined}>
										{item.icon && <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md border border-hairline-steel/60 text-primary transition-[background-color,border-color,color] duration-200 group-hover/item:border-primary group-hover/item:bg-primary group-hover/item:text-primary-foreground"><Icon name={item.icon} class="size-4" /></span>}
										<span class:list={['min-w-0', !item.icon && 'pl-1']}>
											<span class="block text-sm font-medium text-foreground group-hover/item:text-primary-hover">{item.label}</span>
											{item.detail && <span class="mt-0.5 block text-xs leading-relaxed text-muted-foreground">{item.detail}</span>}
										</span>
									</a>
								))}
							</div>
						</div>
						<div class="flex flex-wrap items-center justify-between gap-3 border-t border-hairline-steel/60 px-4 py-2.5">
							<p class="font-mono text-[11px] text-muted-foreground">Send the listing reference. Replies within one business day.</p>
							<a href={viewingHref} class="inline-flex min-h-10 items-center gap-1.5 rounded-md bg-action px-3 text-sm font-medium text-action-foreground transition-[background-color] hover:bg-action-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 dark:bg-action-dark dark:text-action-foreground dark:hover:bg-action-hover">
								<Icon name="calendar" class="size-3.5" />
								<span>Schedule a viewing</span>
							</a>
						</div>
					</div>
				</details>
			))}
		</div>

		<a
			href="/upcoming-projects"
			aria-current={isCurrentPath(Astro.url.pathname, '/upcoming-projects') ? 'page' : undefined}
			class="hidden min-h-10 items-center gap-1.5 rounded-md px-3 text-sm text-muted-foreground transition-[background-color,color] hover:bg-accent hover:text-foreground aria-[current=page]:bg-accent aria-[current=page]:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 xl:inline-flex"
		>
			<span>Upcoming projects</span>
			<Icon name="arrow-up-right" class="size-3.5" />
		</a>

		<div class="flex items-center gap-2">
			<a href="/saved" aria-current={isCurrentPath(Astro.url.pathname, '/saved') ? 'page' : undefined} class="hidden min-h-10 items-center gap-1.5 rounded-md px-3 text-sm text-muted-foreground transition-[background-color,color] hover:bg-accent hover:text-foreground aria-[current=page]:bg-accent aria-[current=page]:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 lg:inline-flex"><Icon name="heart" class="size-3.5" /><span>Saved</span></a>
			<a href={viewingHref} class="hidden h-10 items-center gap-1.5 rounded-md border border-primary px-3 text-sm font-medium text-primary transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 lg:inline-flex">
				<Icon name="calendar" class="size-3.5" />
				<span>Schedule a viewing</span>
			</a>
			<div class="hidden lg:block"><ThemeToggle /></div>
			<button id="mobile-menu-toggle" type="button" aria-label="Toggle navigation menu" aria-controls="mobile-menu-panel" aria-expanded="false" class="inline-flex size-11 cursor-pointer items-center justify-center rounded-md text-muted-foreground transition-[background-color,color,transform] motion-safe:active:scale-[0.96] hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 xl:hidden">
				<span class="relative block size-5" aria-hidden="true">
					<span class="hamburger-line hamburger-line-top absolute left-0 top-[9px] h-0.5 w-5 rounded-full bg-current"></span>
					<span class="hamburger-line hamburger-line-bottom absolute left-0 top-[15px] h-0.5 w-5 rounded-full bg-current"></span>
				</span>
			</button>
		</div>
	</nav>

	<div id="mobile-menu-panel" hidden class="glass max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t-2 border-primary xl:hidden">
		<div class="mx-auto flex max-w-7xl flex-col px-6 py-4">
			<p class="mb-2 font-mono text-[11px] font-medium uppercase tracking-[0.4px] text-primary">Eens property register</p>
			<a href="/upcoming-projects" aria-current={isCurrentPath(Astro.url.pathname, '/upcoming-projects') ? 'page' : undefined} class="mb-2 flex min-h-11 items-center gap-2 rounded-md px-2 py-2 text-sm font-medium text-foreground transition-colors hover:bg-accent hover:text-primary-hover aria-[current=page]:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">
				<Icon name="arrow-up-right" class="size-4 shrink-0" />
				<span>Upcoming projects</span>
			</a>
			<div class="space-y-1">
				{menuGroups.map((group) => (
					<details class="group border-b border-border/60 last:border-b-0">
						<summary class="flex min-h-12 cursor-pointer list-none items-center justify-between py-3 text-sm font-medium text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 [&::-webkit-details-marker]:hidden">
							<span>{group.label}</span>
							<Icon name="chevron-down" class="size-4 text-muted-foreground transition-transform duration-200 group-open:rotate-180" />
						</summary>
						<div class="pb-3">
							<a href={groupHref(group)} class="mb-1 flex min-h-11 items-center gap-2 rounded-md px-2 py-2 text-sm font-medium text-primary transition-colors hover:bg-accent hover:text-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">
								<Icon name="arrow-up-right" class="size-4 shrink-0" />
								<span>{group.linkLabel}</span>
							</a>
							<div class="grid gap-1 sm:grid-cols-2">
							{group.items.map((item) => (
								<a href={item.href} aria-current={isCurrentPath(Astro.url.pathname, item.href) ? 'page' : undefined} class="group/item flex min-h-11 items-start gap-2 rounded-md px-2 py-2 text-sm text-muted-foreground transition-[background-color,color] hover:bg-accent hover:text-foreground aria-[current=page]:bg-secondary aria-[current=page]:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">
									{item.icon && <Icon name={item.icon} class="mt-0.5 size-4 shrink-0 text-primary" />}
									<span>
										<span class="block">{item.label}</span>
										{item.detail && <span class="mt-0.5 block text-xs leading-relaxed text-muted-foreground">{item.detail}</span>}
									</span>
								</a>
							))}
							</div>
						</div>
					</details>
				))}
			</div>				<div class="mt-4 flex items-center justify-between gap-3 border-t border-border/60 pt-4">
				<div class="flex items-center gap-2">
					<a href="/saved" class="inline-flex h-10 items-center gap-1.5 rounded-md px-3 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50"><Icon name="heart" class="size-4" /><span>Saved</span></a>
					{contactLinks.map((link) => (
						<IconLink title={link.title} link={link.link} icon={link.icon} data-tina-field={tinaField(link, 'title')} />
					))}
				</div>
				<div class="flex items-center gap-2">
					<a href={viewingHref} class="inline-flex h-10 items-center gap-1.5 rounded-md border border-primary px-3 text-sm font-medium text-primary transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50"><Icon name="calendar" class="size-3.5" /><span>Viewing</span></a>
					<ThemeToggle />
				</div>
			</div>
		</div>
	</div>
</header>

<style>
	/* Two-line hamburger that morphs into an X when the panel is open. */
	.hamburger-line {
		transition: transform 240ms cubic-bezier(0.2, 0, 0, 1);
	}
	#mobile-menu-toggle[aria-expanded="true"] .hamburger-line-top {
		transform: translateY(3px) rotate(45deg);
	}
	#mobile-menu-toggle[aria-expanded="true"] .hamburger-line-bottom {
		transform: translateY(-3px) rotate(-45deg);
	}
	@media (prefers-reduced-motion: reduce) {
		.hamburger-line { transition: none; }
	}
	details > summary { scrollbar-width: none; }
	details > summary::marker { display: none; }

	/* Anchor the desktop mega panel to the viewport, not the trigger item.
	   A fixed, centered panel cannot spill past the first or last nav item. */
	.mega-panel {
		position: fixed;
		top: 4.25rem;
		left: 50%;
		width: min(52rem, calc(100vw - 2rem));
		max-height: min(34rem, calc(100dvh - 5.25rem));
		overflow-y: auto;
		overflow-x: hidden;
		overscroll-behavior: contain;
		transform: translateX(-50%);
	}

	@keyframes mega-panel-in {
		from {
			opacity: 0;
			transform: translate(-50%, -0.375rem);
		}
		to {
			opacity: 1;
			transform: translate(-50%, 0);
		}
	}

	details[open] > .mega-panel {
		animation: mega-panel-in 160ms ease-out both;
	}

	@media (max-width: 1279px) {
		.mega-panel { display: none; }
	}
</style>

<script is:inline type="module">
	if (!window.__mobileMenuBound) {
		window.__mobileMenuBound = true;
		const setOpen = (open) => {
			const btn = document.getElementById('mobile-menu-toggle');
			const panel = document.getElementById('mobile-menu-panel');
			if (!btn || !panel) return;
			btn.setAttribute('aria-expanded', open ? 'true' : 'false');
			panel.hidden = !open;
			// Lock background scroll while the panel is open; the panel scrolls itself.
			document.documentElement.style.overflow = open ? 'hidden' : '';
		};		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const toggle = target.closest('#mobile-menu-toggle');
			if (toggle) {
				setOpen(toggle.getAttribute('aria-expanded') !== 'true');
				return;
			}
			if (target.closest('#mobile-menu-panel a')) setOpen(false);
			// Tapping anywhere outside the header dismisses the mobile panel too.
			if (!target.closest('header')) setOpen(false);
			if (!target.closest('header details')) {
				document.querySelectorAll('header details[open]').forEach((menu) => menu.removeAttribute('open'));
			}
		});
		document.addEventListener('toggle', (event) => {
			const menu = event.target;
			if (!(menu instanceof HTMLDetailsElement) || !menu.open) return;
			document.querySelectorAll('header details[open]').forEach((other) => {
				if (other !== menu) other.removeAttribute('open');
			});
		}, true);
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			const openSummary = document.querySelector('header details[open] > summary');
			setOpen(false);
			document.querySelectorAll('header details[open]').forEach((menu) => menu.removeAttribute('open'));
			if (openSummary instanceof HTMLElement) openSummary.focus();
		});
		// The panel is desktop-hidden at the xl breakpoint; reset state when crossing it.
		let lastWidth = window.innerWidth;
		window.addEventListener('resize', () => {
			if (window.innerWidth >= 1280 && lastWidth < 1280) setOpen(false);
			lastWidth = window.innerWidth;
		});
	}
</script>
