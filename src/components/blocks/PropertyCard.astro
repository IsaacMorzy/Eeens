---
/**
 * PropertyCard - modern real-estate listing card.
 *
 * Photo-led with the price as the anchor: 16:9 image with availability
 * badge + photo source, then a compact body (type eyebrow + reference,
 * title, address, prominent price row, mono spec rail for Area · Zone ·
 * Lease term, and one clear "View listing" CTA). Stays inside the Eens
 * token system (navy/cyan-teal accent, hairline-steel borders, Plus
 * Jakarta Sans display, JetBrains Mono facts) with no shadow and no glass
 * on evidence surfaces.
 *
 * Data shape is deliberately flat (no `__typename`) so that BOTH the
 * PageBlocks inline card and category directory listings can render the
 * same component with the same data interface.
 */
import { Image } from 'astro:assets';
import { tinaField } from '@tinacms/astro/tina-field';
import AvailabilityBadge from '../ui/AvailabilityBadge.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { Availability } from '../ui/AvailabilityBadge.astro';
import { getPexelsSource } from '../../lib/pexels-images';
import { directoryHrefForType } from '../../lib/property-directories';

export interface PropertyCardData {
	type?: string | null;
	title?: string | null;
	availability?: Availability | null;
	address?: string | null;
	development?: string | null;
	sqft?: string | null;
	price?: { ksh?: string | null; perSqft?: string | null } | null;
	zone?: string | null;
	leaseTerm?: string | null;
	image?: { src?: string | null; alt?: string | null } | null;
	ref?: string | null;
	href?: string | null;
	reference?: string | null;
	viewLabel?: string | null;
}

interface Props {
	data: PropertyCardData;
	featured?: boolean;
	fallbackImageSrc?: string | null;
	[key: string]: unknown;
}

const { data, featured = false, fallbackImageSrc = null, ...rest } = Astro.props as Props & Record<string, unknown>;

const viewHref = data.href ?? directoryHrefForType(data.type, data.ref);
const viewLabel = data.viewLabel ?? 'View property';

// Resolve image src: prefer Tina's heroImage.src, fall back to the local Pexels photo.
const resolvedImageSrc = data.image?.src ?? fallbackImageSrc;
const resolvedImageAlt = data.image?.alt ?? data.title ?? '';
const typeLabel = data.type
	? ({
			SHOP: 'Shop unit',
			WAREHOUSE: 'Warehouse',
			GODOWN: 'Godown',
			BUSINESS_PARK: 'Business park',
			APARTMENT: 'Apartment',
		}[data.type] ?? data.type)
	: null;
const typeIcon = data.type
	? ({
			SHOP: 'building-store',
			WAREHOUSE: 'building-warehouse',
			GODOWN: 'package',
			BUSINESS_PARK: 'building-community',
			APARTMENT: 'building',
		}[data.type] ?? 'building')
	: null;
const sourceUrl = getPexelsSource(resolvedImageSrc);
const hasSpecRail = Boolean(data.sqft || data.zone || data.leaseTerm);
---

<article
	class:list={[
		'group relative flex flex-col overflow-hidden rounded-xl border border-hairline-steel bg-card transition-[background-color,transform,border-color] duration-200 ease-out hover:-translate-y-0.5 hover:border-primary-hover',
		featured ? 'bg-secondary' : 'bg-card',
	]}
	{...rest}
>
	{resolvedImageSrc && (
		<div data-tina-field={tinaField(data as { image?: unknown }, 'image')} class="relative aspect-[16/9] w-full overflow-hidden bg-secondary">
			{viewHref ? (
				<a href={viewHref} aria-label={`View ${data.title ?? 'property'}`} class="block size-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring/50">
					<Image
						src={resolvedImageSrc}
						alt={resolvedImageAlt}
						width={1280}
						height={720}
						sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
						format="webp"
						quality={75}
						loading="lazy"
						decoding="async"
						class="image-outline size-full object-cover transition-transform duration-500 ease-out motion-safe:group-hover:scale-[1.02]"
					/>
				</a>
			) : (
				<Image
					src={resolvedImageSrc}
					alt={resolvedImageAlt}
					width={1280}
					height={720}
					sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
					format="webp"
					quality={75}
					loading="lazy"
					decoding="async"
					class="image-outline size-full object-cover transition-transform duration-500 ease-out motion-safe:group-hover:scale-[1.02]"
				/>
			)}
			{viewHref && (
				<button
					type="button"
					data-save-toggle
					data-save-href={viewHref}
					aria-pressed="false"
					aria-label={`Save ${data.title ?? 'listing'}`}
					class="absolute left-2 top-2 inline-flex size-8 items-center justify-center rounded-full bg-background/90 text-foreground/60 transition-[color,background-color] hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 [&.save-active]:text-primary [&.save-active]:[&_svg]:fill-current"
				>
					<Icon name="heart" class="size-4" />
				</button>
			)}
			{data.availability && (
				<div class="absolute right-2 top-2 rounded-full bg-background/90 p-0.5">
					<AvailabilityBadge availability={data.availability} />
				</div>
			)}
			{sourceUrl && (
				<a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="absolute bottom-2 right-2 inline-flex min-h-8 min-w-8 items-center justify-center rounded-sm bg-background/90 px-2 py-1 font-mono text-[10px] text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">Photo source</a>
			)}
		</div>
	)}
	<div class="flex flex-1 flex-col gap-3 p-5">
		<div class="flex flex-wrap items-center justify-between gap-2">
			{typeLabel && (
				<span data-tina-field={tinaField(data as { type?: unknown }, 'type')} class="inline-flex items-center gap-2 text-[12px] font-medium uppercase tracking-[0.4px] text-primary">
					{typeIcon && <Icon name={typeIcon} class="size-3.5" />}
					<span>{typeLabel}</span>
				</span>
			)}
			{data.reference && (
				<span data-tina-field={tinaField(data as { reference?: unknown }, 'reference')} class="font-mono text-[11px] tabular-nums text-muted-foreground">{data.reference}</span>
			)}
		</div>

		{data.title && (
			<h3 data-tina-field={tinaField(data as { title?: unknown }, 'title')} class="text-balance font-display text-[22px] font-semibold leading-[1.2] tracking-[-0.4px] text-foreground">
				{viewHref ? (
					<a href={viewHref} class="transition-colors hover:text-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">{data.title}</a>
				) : data.title}
			</h3>
		)}

		{data.address && (
			<p data-tina-field={tinaField(data as { address?: unknown }, 'address')} class="flex items-start gap-1.5 text-sm leading-relaxed text-muted-foreground">
				<Icon name="map-pin" class="mt-0.5 size-3.5 shrink-0 text-primary" aria-hidden="true" />
				<span>{data.address}</span>
			</p>
		)}

		{(data.price && (data.price.ksh || data.price.perSqft)) && (
			<div class="mt-1 flex items-baseline justify-between gap-3 border-t border-hairline-steel/60 pt-3">
				<div data-tina-field={tinaField(data as { price?: unknown }, 'price')}>
					<span class="block font-mono text-[11px] uppercase tracking-[0.4px] text-muted-foreground">Price / rate</span>
					{data.price.ksh && (
						<span class="mt-1 block font-display text-xl font-semibold tabular-nums tracking-[-0.3px] text-foreground">KSH {data.price.ksh}</span>
					)}
				</div>
				{data.price.perSqft && (
					<span class="shrink-0 font-mono text-[12px] tabular-nums text-muted-foreground">KSH {data.price.perSqft} / sq ft</span>
				)}
			</div>
		)}

		{hasSpecRail && (
			<dl class="mt-auto grid grid-cols-3 divide-x divide-hairline-steel/50 border-t border-hairline-steel/60 pt-3">
				{data.sqft && (
					<div data-tina-field={tinaField(data as { sqft?: unknown }, 'sqft')} class="pr-2">
						<dt class="flex items-center gap-1 font-mono text-[10px] uppercase tracking-[0.4px] text-muted-foreground"><Icon name="ruler" class="size-3" aria-hidden="true" />Area</dt>
						<dd class="mt-1 font-mono text-[13px] tabular-nums text-foreground/80">{data.sqft}</dd>
					</div>
				)}
				{data.zone && (
					<div data-tina-field={tinaField(data as { zone?: unknown }, 'zone')} class="px-2">
						<dt class="flex items-center gap-1 font-mono text-[10px] uppercase tracking-[0.4px] text-muted-foreground"><Icon name="map-pin" class="size-3" aria-hidden="true" />Zone</dt>
						<dd class="mt-1 font-mono text-[13px] text-foreground/80">{data.zone}</dd>
					</div>
				)}
				{data.leaseTerm && (
					<div data-tina-field={tinaField(data as { leaseTerm?: unknown }, 'leaseTerm')} class="pl-2">
						<dt class="flex items-center gap-1 font-mono text-[10px] uppercase tracking-[0.4px] text-muted-foreground"><Icon name="file-text" class="size-3" aria-hidden="true" />Term</dt>
						<dd class="mt-1 font-mono text-[13px] text-foreground/80">{data.leaseTerm}</dd>
					</div>
				)}
			</dl>
		)}

		{viewHref && (
			<div class="flex items-center justify-between gap-3 border-t border-hairline-steel/40 pt-3">
				{data.development && (
					<span data-tina-field={tinaField(data as { development?: unknown }, 'development')} class="flex min-w-0 items-center gap-1.5 font-mono text-[11px] text-muted-foreground">
						<Icon name="building-community" class="size-3.5 shrink-0 text-primary" aria-hidden="true" />
						<span class="truncate">{data.development}</span>
					</span>
				)}
				<Button href={viewHref} variant="secondary" size="sm" class="ml-auto">
					<span>{viewLabel}</span>
					<Icon name="arrow-up-right" class="size-3.5" />
				</Button>
			</div>
		)}
	</div>
</article>

<script>
	import { loadSavedHrefs, toggleSaved } from '../../lib/saved-listings';

	const render = () => {
		const saved = loadSavedHrefs();
		for (const button of document.querySelectorAll<HTMLButtonElement>('[data-save-toggle]')) {
			const active = saved.has(button.dataset.saveHref ?? '');
			button.setAttribute('aria-pressed', String(active));
			button.classList.toggle('save-active', active);
			button.setAttribute('aria-label', active ? 'Remove from saved listings' : 'Save listing');
		}
	};

	document.addEventListener('click', (event) => {
		const target = event.target as HTMLElement | null;
		const button = target?.closest<HTMLButtonElement>('[data-save-toggle]');
		if (!button || !button.dataset.saveHref) return;
		event.preventDefault();
		toggleSaved(button.dataset.saveHref);
		render();
		document.dispatchEvent(new CustomEvent('eens:saved-change'));
	});

	render();
</script>
