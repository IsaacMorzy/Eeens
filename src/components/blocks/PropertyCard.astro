---
/**
 * PropertyCard - visual card per DESIGN.md § Components > Cards > property-card.
 * surface-1-light (bg-background) + 1 px hairline border + rounded-xl.
 * 16:9 hero, 12 px cyan-teal eyebrow (type uppercase), 22 px card-title
 * (Plus Jakarta Sans, medium), 16 px address, mono sq-ft annotation,
 * inline price row (KSH + per_sqft if present), availability badge
 * top-right (optional), location chip + lease term chip row,
 * cyan-teal-into-hairline "View property" CTA at the bottom rail.
 *
 * Data shape is deliberately flat (no `__typename`) so that BOTH the
 * PageBlocks inline card and category directory listings can render
 * the same component with the same data interface.
 */
import { tinaField } from '@tinacms/astro/tina-field';
import AvailabilityBadge from '../ui/AvailabilityBadge.astro';
import LocationPin from '../ui/LocationPin.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { Availability } from '../ui/AvailabilityBadge.astro';
import { getPexelsSource } from '../../lib/pexels-images';
import { directoryHrefForType } from '../../lib/property-directories';

export interface PropertyCardData {
	type?: string | null;
	title?: string | null;
	availability?: Availability | null;
	address?: string | null;
	development?: string | null;
	sqft?: string | null;
	price?: { ksh?: string | null; perSqft?: string | null } | null;
	zone?: string | null;
	leaseTerm?: string | null;
	image?: { src?: string | null; alt?: string | null } | null;
	ref?: string | null;
	href?: string | null;
	viewLabel?: string | null;
}

interface Props {
	data: PropertyCardData;
	featured?: boolean;
	fallbackImageSrc?: string | null;
	[key: string]: unknown;
}

const { data, featured = false, fallbackImageSrc = null, ...rest } = Astro.props as Props & Record<string, unknown>;

const viewHref = data.href ?? directoryHrefForType(data.type, data.ref);
const viewLabel = data.viewLabel ?? 'View property';
const mapHref = data.address || data.zone
	? `https://www.google.com/maps/search/${encodeURIComponent((data.address ?? data.zone) as string)}`
	: undefined;

// Resolve image src: prefer Tina's heroImage.src, fall back to the local Pexels photo.
const resolvedImageSrc = data.image?.src ?? fallbackImageSrc;
const resolvedImageAlt = data.image?.alt ?? data.title ?? '';
const sourceUrl = getPexelsSource(resolvedImageSrc);
---

<article
	class:list={[
		'group relative flex flex-col overflow-hidden rounded-xl border border-hairline-steel transition-[transform,border-color,box-shadow] duration-200 ease-out hover:-translate-y-0.5 hover:border-primary-hover hover:shadow-sm',
		featured ? 'bg-secondary' : 'bg-background',
	]}
	{...rest}
>		{resolvedImageSrc && (
			<div data-tina-field={tinaField(data as { image?: unknown }, 'image')} class="relative aspect-[16/9] w-full overflow-hidden bg-secondary">
				{viewHref ? (
					<a href={viewHref} aria-label={`View ${data.title ?? 'property'}`} class="block size-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring/50">
						<img
							src={resolvedImageSrc}
							alt={resolvedImageAlt}
							width={1280}
							height={720}
							loading="lazy"
							decoding="async"
							class="image-outline size-full object-cover transition-transform duration-500 ease-out motion-safe:group-hover:scale-[1.02]"
						/>
					</a>
				) : (
					<img
						src={resolvedImageSrc}
						alt={resolvedImageAlt}
						width={1280}
						height={720}
						loading="lazy"
						decoding="async"
						class="image-outline size-full object-cover transition-transform duration-500 ease-out motion-safe:group-hover:scale-[1.02]"
					/>
				)}
			</div>
		)}
	<div class="flex flex-1 flex-col gap-4 p-6">
		{(data.type || data.availability) && (
			<div class="flex flex-wrap items-center justify-between gap-2">
				{data.type && (
					<span data-tina-field={tinaField(data as { type?: unknown }, 'type')} class="text-[13px] font-medium uppercase tracking-[0.4px] text-primary">
						{data.type}
					</span>
				)}
				{data.availability && <AvailabilityBadge availability={data.availability} />}
			</div>
		)}
		{data.title && (
			<h3 data-tina-field={tinaField(data as { title?: unknown }, 'title')} class="font-display text-[22px] font-medium leading-[1.25] tracking-[-0.4px] text-foreground">
				{viewHref ? (
					<a href={viewHref} class="transition-colors hover:text-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">{data.title}</a>
				) : data.title}
			</h3>
		)}
		{data.address && (
			<p data-tina-field={tinaField(data as { address?: unknown }, 'address')} class="text-sm text-muted-foreground">
				{data.address}
			</p>
		)}
		{data.development && (
			<div data-tina-field={tinaField(data as { development?: unknown }, 'development')} class="flex items-center gap-2 font-mono text-[12px] text-muted-foreground">
				<Icon name="building-community" aria-hidden="true" class="size-3.5 shrink-0 text-primary" />
				<span>{data.development}</span>
			</div>
		)}
		{data.sqft && (
			<div data-tina-field={tinaField(data as { sqft?: unknown }, 'sqft')} class="font-mono tabular-nums text-[13px] text-foreground/80">
				{data.sqft}
			</div>
		)}
		{data.price && (data.price.ksh || data.price.perSqft) && (
			<div data-tina-field={tinaField(data as { price?: unknown }, 'price')} class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
				{data.price.ksh && (
					<span class="font-display text-base font-semibold tracking-[-0.2px] text-foreground">KSH {data.price.ksh}</span>
				)}
				{data.price.perSqft && (
					<span class="font-mono text-[13px] text-muted-foreground">KSH {data.price.perSqft} / sq ft</span>
				)}
			</div>
		)}
		{sourceUrl && (
			<a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center self-start rounded-sm font-mono text-[11px] text-muted-foreground underline-offset-2 hover:text-foreground hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">Photo source</a>
		)}
		{(data.zone || data.leaseTerm) && (
			<div class="flex flex-wrap items-center gap-2 pt-2">
				{data.zone && (
					<div data-tina-field={tinaField(data as { zone?: unknown }, 'zone')}>
						<LocationPin zone={data.zone} mapHref={mapHref} />
					</div>
				)}
				{data.leaseTerm && (
					<span data-tina-field={tinaField(data as { leaseTerm?: unknown }, 'leaseTerm')} class="inline-flex h-6 items-center rounded-sm border border-hairline-steel/60 bg-background px-2 text-xs font-medium text-foreground">
						{data.leaseTerm}
					</span>
				)}
			</div>
		)}
		{viewHref && (
			<div class="mt-auto flex items-center justify-end pt-4">
				<Button href={viewHref} variant="secondary" size="sm">
					<span>{viewLabel}</span>
					<Icon name="arrow-up-right" class="size-3.5" />
				</Button>
			</div>
		)}
	</div>
</article>
