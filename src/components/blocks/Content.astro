---
import { Image } from 'astro:assets';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import Section from '../ui/Section.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import ContextualVisual from '../ui/ContextualVisual.astro';
import { getPageContentVisual } from '../../lib/contextual-images';
import type { ContentBlock } from '../../lib/data';

interface Props { data: ContentBlock; slug?: string; index?: number; headingLevel?: 'h1' | 'h2' }

const { data, slug = '', index = 0, headingLevel = 'h2' } = Astro.props;
const contextualVisual = getPageContentVisual(slug, index);
---

<Section class="overflow-hidden">
	<div class="reveal-on-scroll mx-auto max-w-3xl">
		{data.title && (headingLevel === 'h1' ? <h1 data-tina-field={tinaField(data, 'title')} class="text-balance font-display text-4xl font-semibold tracking-[-1.0px] md:text-5xl md:tracking-[-1.4px]">{data.title}</h1> : <h2 data-tina-field={tinaField(data, 'title')} class="text-balance font-display text-3xl font-semibold tracking-[-0.6px] md:text-4xl md:tracking-[-1.0px]">{data.title}</h2>)}
		{data.description && (
			<p data-tina-field={tinaField(data, 'description')} class="mt-3 max-w-2xl text-pretty text-base text-muted-foreground">
				{data.description}
			</p>
		)}
	</div>
	{data.image?.src ? (
		<div data-tina-field={tinaField(data, 'image')} class="mx-auto mt-8 w-full max-w-2xl">
			<Image
				src={data.image.src}
				alt={data.image.alt ?? ''}
				width={1655}
				height={2340}
				sizes="(min-width: 672px) 672px, 100vw"
				format="webp"
				quality={80}
				loading="lazy"
				decoding="async"
				class="h-auto w-full rounded-xl border border-hairline-steel bg-secondary"
			/>
		</div>
	) : contextualVisual && (
		<div class="mx-auto mt-8 w-full max-w-7xl">
			<ContextualVisual visual={contextualVisual} />
		</div>
	)}
	<div class="reveal-on-scroll mx-auto mt-8 max-w-3xl prose prose-lg" data-tina-field={tinaField(data, 'body')}>
		<TinaMarkdown content={data.body} />
	</div>
</Section>
