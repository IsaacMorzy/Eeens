---
import { Image } from 'astro:assets';
import { tinaField } from '@tinacms/astro/tina-field';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { cn } from '../../lib/cn';
import { getPageHeroVisual } from '../../lib/contextual-images';
import ContextualVisual from '../ui/ContextualVisual.astro';
import type { SplitAction, SplitBlock } from '../../lib/data';
import { getPexelsSource } from '../../lib/pexels-images';

interface Props { data: SplitBlock; slug?: string }

const { data, slug = '' } = Astro.props;
const actions: SplitAction[] = (data.actions ?? []).filter(
	(a: SplitAction | null | undefined): a is SplitAction => a !== null && a !== undefined,
);
const fallbackVisual = getPageHeroVisual(slug);
const cmsImageSource = getPexelsSource(data.image?.src);
---
<Section>
	<div class="reveal-on-scroll mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-2 md:gap-16">
		<div class={cn('space-y-6', data.reverse && 'md:order-2')}>
			{data.title && <h2 data-tina-field={tinaField(data, 'title')} class="text-balance font-display text-3xl font-semibold tracking-[-0.6px] lg:text-4xl lg:tracking-[-1.0px]">{data.title}</h2>}
			{data.body && (
				<div data-tina-field={tinaField(data, 'body')} class="prose prose-lg max-w-none text-muted-foreground">
					<TinaMarkdown content={data.body} />
				</div>
			)}
			{actions.length > 0 && (
				<div class="flex flex-wrap gap-3 pt-2">
					{actions.map((action: SplitAction) => (
						<div data-tina-field={tinaField(action)}>
							<Button href={action.link} size="lg" variant={action.type === 'link' ? 'ghost' : 'default'}>
								{action.icon && <Icon name={action.icon} class="size-4" />}
								<span class="text-nowrap">{action.label}</span>
							</Button>
						</div>
					))}
				</div>
			)}
		</div>
		{data.image?.src ? (
			<div data-tina-field={tinaField(data, 'image')} class="relative overflow-hidden rounded-xl border border-hairline-steel">
				<Image
					src={data.image.src}
					alt={data.image.alt ?? ''}
					width={1280}
					height={960}
					sizes="(min-width: 768px) 600px, 100vw"
					format="webp"
					quality={80}
					loading="lazy"
					decoding="async"
					class="aspect-[4/3] size-full object-cover"
				/>
				{cmsImageSource && <a href={cmsImageSource} target="_blank" rel="noopener noreferrer" class="absolute bottom-2 right-2 rounded-sm bg-background/90 px-1.5 py-1 font-mono text-[10px] text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">Pexels source</a>}
			</div>
		) : fallbackVisual ? (
			<ContextualVisual visual={fallbackVisual} />
		) : null}
	</div>
</Section>
