---
import { tinaField } from '@tinacms/astro/tina-field';
import Callout from './Callout.astro';
import Content from './Content.astro';
import Cta from './Cta.astro';
import CtaBanner from './CTABanner.astro';
import Features from './Features.astro';
import CareersForm from './CareersForm.astro';
import InquiryForm from './InquiryForm.astro';
import Gallery from './Gallery.astro';
import Hero from './Hero.astro';
import PropertyCard from './PropertyCard.astro';
import PropertyList from './PropertyList.astro';
import ListingSearch from './ListingSearch.astro';
import Split from './Split.astro';
import Stats from './Stats.astro';
import Testimonial from './Testimonial.astro';
import Video from './Video.astro';
import type { CareersFormBlock, CmsPage, GalleryBlock, InquiryFormBlock } from '../../lib/data';

interface Props {
	data?: CmsPage | null;
	slug?: string;
}

const { data, slug = '' } = Astro.props;
const blocks = (data?.blocks ?? []).filter(b => b !== null);
const firstHeadingIndex = blocks.findIndex((block) => {
	if (block.__typename === 'PageBlocksHero') return Boolean(block.headline);
	if (block.__typename === 'PageBlocksContent' || block.__typename === 'PageBlocksSplit') {
		return Boolean(block.title);
	}
	return false;
});
---

{blocks.map((block, i) => {
	if ((block as { __typename?: string }).__typename === 'PageBlocksGallery') {
		return <div data-tina-field={tinaField(block)}><Gallery data={block as unknown as GalleryBlock} /></div>;
	}
	if ((block as { __typename?: string }).__typename === 'PageBlocksCareersForm') {
		return <div data-tina-field={tinaField(block)}><CareersForm data={block as unknown as CareersFormBlock} /></div>;
	}
	if ((block as { __typename?: string }).__typename === 'PageBlocksInquiryForm') {
		return <div data-tina-field={tinaField(block)}><InquiryForm data={block as unknown as InquiryFormBlock} /></div>;
	}
	const rendered = (() => {
		switch (block.__typename) {
			case 'PageBlocksCallout': return <Callout data={block} />;
			case 'PageBlocksContent': return <Content data={block} slug={slug} index={blocks.slice(0, i).filter((b) => b.__typename === 'PageBlocksContent').length} headingLevel={i === firstHeadingIndex ? 'h1' : 'h2'} />;
			case 'PageBlocksCta': return <Cta data={block} />;
			case 'PageBlocksCtaBanner': return <CtaBanner data={block} />;
			case 'PageBlocksFeatures': return <Features data={block} />;
			case 'PageBlocksHero': return <Hero data={block} slug={slug} />;
			case 'PageBlocksPropertyCard': return <PropertyCard data={block as unknown as import('./PropertyCard.astro').PropertyCardData} />;
			case 'PageBlocksPropertyList': return <PropertyList data={block} />;
			case 'PageBlocksListingSearch': return <ListingSearch data={block as unknown as import('./ListingSearch.astro').ListingSearchData} />;
			case 'PageBlocksSplit': return <Split data={block} slug={slug} headingLevel={i === firstHeadingIndex ? 'h1' : 'h2'} />;
			case 'PageBlocksStats': return <Stats data={block} />;
			case 'PageBlocksTestimonial': return <Testimonial data={block} />;
			case 'PageBlocksVideo': return <Video data={block} />;
		}
	})();
	return (
		<div data-tina-field={tinaField(block)}>{rendered}</div>
	);
})}
