---
import { cloudinaryUrl, cloudinarySrcSet } from '../../lib/cloudinary';
import { tinaField } from '@tinacms/astro/tina-field';
import Section from '../ui/Section.astro';

interface GalleryItem {
	image?: { src?: string | null; alt?: string | null } | null;
	caption?: string | null;
	kind?: string | null;
	sourceUrl?: string | null;
}

interface GalleryData {
	title?: string | null;
	description?: string | null;
	items?: Array<GalleryItem | null> | null;
}

interface Props { data: GalleryData }

const { data } = Astro.props;
const items = (data.items ?? []).filter((item): item is GalleryItem => Boolean(item?.image?.src));
const tinaData = data as unknown as Record<string, unknown>;
const safeSourceUrl = (url?: string | null): string | null => url?.startsWith('https://') ? url : null;
---

<Section class="overflow-hidden">
	<div class="mx-auto max-w-3xl">
		{data.title && <h2 data-tina-field={tinaField(tinaData, 'title')} class="text-balance font-display text-3xl font-semibold tracking-[-0.6px] md:text-4xl md:tracking-[-1px]">{data.title}</h2>}
		{data.description && <p data-tina-field={tinaField(tinaData, 'description')} class="mt-4 max-w-2xl text-pretty text-base leading-relaxed text-muted-foreground">{data.description}</p>}
	</div>

	{items.length > 0 ? (
		<div class="mx-auto mt-10 grid max-w-7xl gap-5 sm:grid-cols-2 lg:grid-cols-12">
			{items.map((item, index) => (
				<figure data-tina-field={tinaField(item as unknown as Record<string, unknown>)} class:list={[
					'group overflow-hidden rounded-xl border border-hairline-steel bg-card',
					index === 0 ? 'sm:col-span-2 lg:col-span-7' : 'lg:col-span-5',
				]}>
					<img
						src={cloudinaryUrl(item.image?.src) ?? ''}
						alt={item.image?.alt ?? ''}
						width="1600"
						height="1000"
						srcset={cloudinarySrcSet(item.image?.src, [640, 960, 1280, 1600]) ?? undefined}
						sizes={index === 0 ? '(min-width: 1024px) 58vw, 100vw' : '(min-width: 1024px) 42vw, 100vw'}
						loading={index === 0 ? 'eager' : 'lazy'}
						decoding="async"
						class="image-outline aspect-[4/3] w-full object-cover transition-transform duration-500 ease-out motion-safe:group-hover:scale-[1.02]"
					/>
					<figcaption class="border-t border-hairline-steel/40 px-4 py-3">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<span class="font-mono text-[11px] uppercase tracking-[0.4px] text-primary">{item.kind ?? 'Published image'}</span>
							{safeSourceUrl(item.sourceUrl) && <a href={safeSourceUrl(item.sourceUrl) ?? undefined} target="_blank" rel="noopener noreferrer" class="min-h-10 inline-flex items-center font-mono text-[11px] text-muted-foreground underline-offset-2 hover:text-foreground hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">Photo source</a>}
						</div>
						<p data-tina-field={tinaField(item as unknown as Record<string, unknown>, 'caption')} class="mt-2 text-sm leading-relaxed text-foreground">{item.caption}</p>
					</figcaption>
				</figure>
			))}
		</div>
	) : (
		<div class="mx-auto mt-10 max-w-2xl rounded-xl border border-dashed border-hairline-steel bg-secondary p-8">
			<p class="font-mono text-[12px] uppercase tracking-[0.4px] text-primary">Gallery status</p>
			<h3 class="mt-3 font-display text-2xl font-medium">No approved images are published yet.</h3>
			<p class="mt-3 text-muted-foreground">Add an approved image, alt text, caption, image role, and source in Tina before publishing it here.</p>
		</div>
	)}
</Section>
