---
const {
	pathname = '/warehouses',
	label = 'Operating zones',
} = Astro.props;

const zones = [
	{ name: 'Mlolongo', detail: 'Mombasa Road, KM 12–14', x: 190, y: 92 },
	{ name: 'Syokimau', detail: 'Mombasa Road, KM 11', x: 420, y: 72 },
	{ name: 'Baba Dogo', detail: 'Outering Road', x: 640, y: 128 },
	{ name: 'Thika', detail: 'Flame Tree Park Estate', x: 850, y: 62 },
];

const zoneHref = (zone: string) => `${pathname}?zone=${encodeURIComponent(zone)}`;
---

<details class="group rounded-xl border border-hairline-steel bg-background lg:open:border-transparent" open data-directory-map>
	<summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display text-lg font-medium marker:hidden lg:cursor-default lg:px-0 lg:py-0">
		<span>{label}</span>
		<span class="font-mono text-[12px] text-muted-foreground lg:hidden">Show map</span>
	</summary>
	<div class="pt-4 lg:pt-0">
		<div class="overflow-hidden rounded-xl border border-hairline-steel bg-secondary p-3 sm:p-5">
			<svg
				viewBox="0 0 1040 220"
				role="img"
				aria-label={`${label}: Mlolongo, Syokimau, Baba Dogo, and Thika`}
				class="h-auto w-full text-muted-foreground"
			>
				<path d="M70 164 C230 124 350 184 500 128 S790 110 970 54" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="5 8" opacity=".5" />
				<path d="M70 188 H970" fill="none" stroke="currentColor" stroke-width="1" opacity=".25" />
				{zones.map((zone) => (
					<a href={zoneHref(zone.name)} aria-label={`Filter listings by ${zone.name}`}>
						<circle cx={zone.x} cy={zone.y} r="18" fill="var(--background)" stroke="var(--primary)" stroke-width="1.5" />
						<circle cx={zone.x} cy={zone.y} r="5" fill="var(--primary)" />
						<text x={zone.x} y={zone.y + 42} text-anchor="middle" class="fill-foreground font-sans text-[13px] font-medium">{zone.name}</text>
						<text x={zone.x} y={zone.y + 59} text-anchor="middle" class="fill-muted-foreground font-mono text-[11px]">{zone.detail}</text>
					</a>
				))}
			</svg>
		</div>
		<p class="mt-3 font-mono text-[12px] text-muted-foreground">Schematic only; not to scale. Select a zone to filter published records.</p>
		<nav aria-label={`${label} links`} class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
			{zones.map((zone) => (
				<a href={zoneHref(zone.name)} class="min-h-10 inline-flex items-center text-sm font-medium text-primary underline-offset-4 hover:text-primary-hover hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">{zone.name}</a>
			))}
		</nav>
	</div>
</details>

<script>
	const map = document.querySelector('[data-directory-map]');
	if (map && window.matchMedia('(max-width: 1023px)').matches) map.removeAttribute('open');
</script>
