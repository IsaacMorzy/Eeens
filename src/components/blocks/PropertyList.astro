---
/**
 * PropertyList - page block dispatcher that pulls listings from
 * the dedicated `property` Tina collection. The block's own fields
 * are configuration only (limit, filterType, filterZone, layout,
 * display); the actual data comes from listProperties().
 *
 * Per DESIGN.md § Layout > Property card grid: 3-up desktop →
 * 2-up tablet → 1-up mobile.
 */
import PropertyCardFeatured from './PropertyCardFeatured.astro';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { listProperties, type PropertyNode, type Action } from '../../lib/data';
import { getIllustrationSrc } from '../../lib/property-filters';
import { tinaField } from '@tinacms/astro/tina-field';
import type { Availability } from '../ui/AvailabilityBadge.astro';

interface PropertyListBlockData {
	title?: string | null;
	description?: string | null;
	limit?: number | null;
	filterType?: string | null;
	filterZone?: string | null;
	filterAvailability?: string | null;
	layout?: 'grid' | 'strip' | null;
	display?: 'featured' | 'standard' | null;
	actions?: Action[] | null;
}

interface Props { data: PropertyListBlockData }

const { data } = Astro.props as Props & Record<string, unknown>;
const blockActions: Action[] = (data.actions ?? []).filter(
	(a: Action | null | undefined): a is Action => a !== null && a !== undefined,
);

const all: PropertyNode[] = await listProperties();
const limit = data.limit === null || data.limit === undefined
	? 6
	: Math.max(0, Math.min(data.limit, 24));
const filtered: PropertyNode[] = all.filter((p: PropertyNode): boolean => {
	if (data.filterType && data.filterType !== 'ALL' && p.type !== data.filterType) return false;
	if (data.filterZone && p.zone !== data.filterZone) return false;
	if (data.filterAvailability && data.filterAvailability !== 'ALL' && p.availability !== data.filterAvailability) return false;
	return true;
});
const listings = limit === 0 ? filtered : filtered.slice(0, limit);
---

<Section data-listing-results>
	<div class="mx-auto w-full">
		{(data.title || data.description || blockActions.length > 0) && (
			<header class="mb-8 flex flex-wrap items-end justify-between gap-4 md:mb-10">
				<div class="max-w-2xl">
					{data.title && (
						<h2 data-listing-results-title data-tina-field={tinaField(data as { title?: unknown }, 'title')} class="font-display text-balance text-3xl font-semibold tracking-[-0.6px] md:text-4xl md:tracking-[-1.0px]">
							{data.title}
						</h2>
					)}
					{data.description && (
						<p data-tina-field={tinaField(data as { description?: unknown }, 'description')} class="mt-3 text-pretty text-base text-muted-foreground">
							{data.description}
						</p>
					)}
				</div>
				{blockActions.length > 0 && (
					<div class="flex shrink-0 flex-wrap items-center gap-3">
						{blockActions.map((action: Action) => (
							<Button href={action.link} variant={action.type === 'link' ? 'ghost' : 'default'} size="lg">
								{action.icon && <Icon name={action.icon} class="size-4" />}
								<span>{action.label}</span>
							</Button>
						))}
					</div>
				)}
			</header>
		)}
		<p data-listing-result-status role="status" aria-live="polite" class="mb-5 font-mono text-[12px] text-muted-foreground">{listings.length} published listing{listings.length === 1 ? '' : 's'}</p>
		<div data-listing-grid class:list={[data.layout === 'strip' ? 'flex flex-col gap-6' : data.display === 'featured' ? 'grid gap-8 sm:grid-cols-2 lg:grid-cols-4' : 'grid gap-8 sm:grid-cols-2 lg:grid-cols-3']}>
			{listings.map((p: PropertyNode, index: number) => (
				<div data-listing-card data-listing-type={p.type ?? ''} data-listing-zone={p.zone ?? ''} data-listing-availability={p.availability ?? ''} class:list={[data.display === 'featured' && index === 0 && 'lg:col-span-2']}>
				<PropertyCardFeatured
					data={{
						type: p.type ?? null,
						title: p.title ?? null,
						availability: (p.availability as Availability | null) ?? null,
						address: p.address ?? null,
						development: p.development ?? null,
						sqft: p.sqft ?? null,
						price: p.price ?? null,
						zone: p.zone ?? null,
						leaseTerm: p.leaseTerm ?? null,
						image: p.heroImage ?? null,
						ref: p._sys?.filename ?? null,
						reference: p.reference ?? null,
						viewLabel: 'View listing',
					}}
					fallbackImageSrc={getIllustrationSrc(p.type)}
				/>
				</div>
			))}
		</div>
		<div data-listing-empty hidden class="max-w-2xl rounded-xl border border-hairline-steel bg-secondary p-6 sm:p-8">
			<h3 class="font-display text-2xl font-medium tracking-[-0.4px]">No published listings match this search.</h3>
			<p class="mt-3 text-muted-foreground">Clear a filter to see the full published register.</p>
			<button type="button" data-listing-clear class="mt-5 inline-flex min-h-11 items-center rounded-md border border-hairline-steel bg-background px-4 text-sm font-medium text-foreground hover:border-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">Clear search</button>
		</div>
	</div>
</Section>
