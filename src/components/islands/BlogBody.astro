---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsBlog } from '../../lib/data';
import FormattedDate from '../FormattedDate.astro';
import YouTubeEmbed from '../mdx/YouTubeEmbed.astro';
import { countWords, readingMinutes as minutesForWordCount } from '../../lib/blog-walker';
import { getPexelsSource } from '../../lib/pexels-images';
import { cloudinaryUrl, cloudinarySrcSet } from '../../lib/cloudinary';

interface Props {
	data?: CmsBlog | null;
}

const { data } = Astro.props;
const computedBodyWordCount = countWords(data?.body);
const readingMinutes = minutesForWordCount(computedBodyWordCount);
const components = { YouTubeEmbed };
const headlineId = `blog-${data?._sys?.filename ?? 'post'}`;
const heroSource = getPexelsSource(data?.heroImage);
---

{
	data?.heroImage ? (
		<div data-tina-field={tinaField(data, 'heroImage')} class="relative mx-auto mt-8 w-full max-w-7xl px-6 lg:px-10">
			<img
				width={1920}
				height={820}
				src={cloudinaryUrl(data.heroImage) ?? ''}
				srcset={cloudinarySrcSet(data.heroImage, [640, 960, 1280, 1920]) ?? undefined}
				sizes="100vw"
				alt={data.title ?? 'Eens journal article'}
				loading="eager"
				fetchpriority="high"
				decoding="async"
				class="image-outline aspect-[21/9] w-full rounded-xl border border-hairline-steel object-cover"
			/>
			{heroSource && <a href={heroSource} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block rounded-sm font-mono text-[11px] text-muted-foreground underline-offset-2 hover:text-foreground hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">Photo source</a>}
		</div>
	) : null
}

<div class="mx-auto max-w-3xl px-6 py-12">
	{data && (
		<header class="mb-8">
			{(data.pubDate || readingMinutes) && (
				<div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px] text-muted-foreground">
					{data.pubDate && <span data-tina-field={tinaField(data, 'pubDate')}><FormattedDate date={new Date(data.pubDate)} />{data.updatedDate && <span data-tina-field={tinaField(data, 'updatedDate')} class="italic">{' '}Updated <FormattedDate date={new Date(data.updatedDate)} /></span>}</span>}
					{data.pubDate && readingMinutes && <span aria-hidden="true" class="text-hairline-steel/60">·</span>}
					{readingMinutes && <span class="font-mono tabular-nums">{readingMinutes} min read</span>}
				</div>
			)}
			<h1 id={headlineId} data-tina-field={tinaField(data, 'title')} class="reveal-on-scroll font-display text-balance text-4xl font-semibold tracking-[-1.0px] md:text-6xl md:tracking-[-1.8px]">{data.title}</h1>
			{data.description && <p class="mt-4 max-w-2xl text-pretty text-lg text-muted-foreground">{data.description}</p>}
		</header>
	)}
	{data && <div data-tina-field={tinaField(data, 'body')} class="prose prose-lg max-w-none prose-headings:font-display prose-headings:tracking-[-0.4px] prose-a:text-primary prose-a:no-underline hover:prose-a:text-primary-hover"><TinaMarkdown content={data.body} components={components} /></div>}
</div>
