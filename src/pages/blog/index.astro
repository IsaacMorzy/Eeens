---
import Base from '../../layouts/Base.astro';
import Section from '../../components/ui/Section.astro';
import { contactEmail, getConfig, listBlogs, type CmsBlog } from '../../lib/data';
import ContextualVisual from '../../components/ui/ContextualVisual.astro';
import { getBlogVisual } from '../../lib/contextual-images';
import { paginate, pageHref, parsePage } from '../../lib/pagination';

const blogs: CmsBlog[] = await listBlogs();
const config = (await getConfig()).data?.config ?? null;
const updatesHref = `mailto:${contactEmail(config)}?subject=${encodeURIComponent('Subscribe to listing updates')}`;
const { items: visibleBlogs, meta: pagination } = paginate(blogs, parsePage(Astro.url.searchParams.get('page')), 5);
---

<Base
	title="Blog — Eens Limited"
	description="Notes from the operator's desk. Industrial leasing, residential sale, and the operational details behind both."
>
	<Section class="bg-background">
		<div class="reveal-on-scroll mx-auto grid max-w-5xl items-center gap-10 md:grid-cols-[1.1fr_0.9fr] md:text-left">
			<div>
			<span class="text-[13px] font-medium uppercase tracking-[0.4px] text-primary">Blog</span>
			<h1 class="mt-3 font-display text-balance text-4xl font-semibold tracking-[-1.0px] md:text-6xl md:tracking-[-1.8px]">
				Notes from the operator's desk.
			</h1>
			<p class="mx-auto mt-6 max-w-2xl text-pretty text-lg text-muted-foreground">
				What we publish on every listing, what we don't, and why. Written for the people we lease to and the
				people we sell to, not for a glossy brochure.
			</p>
			</div>
			<ContextualVisual visual={getBlogVisual(blogs[0]?._sys?.filename)} priority />
		</div>
	</Section>

	<Section class="bg-background pb-section">
		<div class="reveal-on-scroll-stagger mx-auto max-w-3xl">
			{blogs.length === 0 && (
				<p class="text-center text-muted-foreground">No posts yet.</p>
			)}
			<ul class="divide-y divide-hairline-steel/40 border-y border-hairline-steel/60">
				{visibleBlogs.map((b) => (
					<li class="reveal-on-scroll py-6 transition-all duration-200 ease-out hover:translate-x-1">
						<a href={`/blog/${b._sys?.filename ?? ''}`} class="group block">
							<div class="font-mono text-[13px] uppercase tracking-[0.4px] text-muted-foreground">
								{b.pubDate && new Date(b.pubDate).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: '2-digit' })}
							</div>
							<h2 class="mt-2 font-display text-[22px] font-medium leading-[1.25] tracking-[-0.4px] text-foreground transition-colors group-hover:text-primary-hover">
								{b.title}
							</h2>
							{b.description && (
								<p class="mt-2 max-w-2xl text-pretty text-base text-muted-foreground">{b.description}</p>
							)}
						</a>
					</li>
				))}
			</ul>
			<div class="mt-10 flex flex-col items-center gap-4 text-center">
				<p class="font-mono text-[13px] text-muted-foreground">
					{pagination.from}–{pagination.to} of {blogs.length} post{blogs.length === 1 ? '' : 's'}.
				</p>
				{pagination.totalPages > 1 && (
					<nav aria-label="Blog pagination" class="flex items-center gap-3">
						{pagination.page > 1 && <a href={pageHref('/blog', {}, pagination.page - 1)} class="inline-flex h-10 items-center rounded-md border border-hairline-steel px-4 text-sm text-muted-foreground transition-colors hover:border-primary-hover hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">Previous</a>}
						<span class="font-mono text-[13px] text-muted-foreground">Page {pagination.page} of {pagination.totalPages}</span>
						{pagination.page < pagination.totalPages && <a href={pageHref('/blog', {}, pagination.page + 1)} class="inline-flex h-10 items-center rounded-md border border-hairline-steel px-4 text-sm text-muted-foreground transition-colors hover:border-primary-hover hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">Next</a>}
					</nav>
				)}
			</div>
		</div>
	</Section>

	<Section class="bg-canvas-dark text-ink-dark">
		<div class="reveal-on-scroll mx-auto max-w-3xl text-center">
			<span class="inline-block text-[13px] font-medium uppercase tracking-[0.4px] text-primary-dark">STAY UPDATED</span>
			<h2 class="mt-4 font-display text-balance text-[28px] font-semibold tracking-[-0.6px]">
				Listing updates and operator notes.
			</h2>
			<p class="mt-4 max-w-xl mx-auto text-pretty text-base text-ink-dark/75">
				Email us if you want a note when a new listing goes live. We do not send a fixed newsletter.
			</p>
			<div class="mt-8">
				<a
					href={updatesHref}
					class="inline-flex items-center gap-2 rounded-md bg-primary-dark text-canvas-dark px-6 py-3 text-sm font-medium transition-[background-color] duration-200 ease-out hover:bg-primary-dark/90"
				>
					<span>Email me listing updates</span>
				</a>
			</div>
		</div>
	</Section>
</Base>
