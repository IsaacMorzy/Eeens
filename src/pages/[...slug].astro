---
import Base from '../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PageBody from '../components/islands/PageBody.astro';
import { getConfig, getPage, listPages, listProperties } from '../lib/data';
import { stableStringify } from '../lib/cache-key';
import { islands } from '../lib/islands';

export async function getStaticPaths() {
	const pages = await listPages();
	const properties = await listProperties();
	const config = await getConfig();
	return pages
		.filter((node) => node._sys.filename !== 'home')
		.map((node) => ({
			params: { slug: node._sys.filename },
			// The Tina page node contains the blocks rendered by this route.
			cacheKey: stableStringify({ page: node, pages, properties, config: config.data?.config }),
		}));
}

const slug = (Astro.params.slug ?? '').toString();
const page = await getPage(slug);
const data = page.data?.page;
if (!data) return new Response('Not Found', { status: 404 });
const config = (await getConfig()).data?.config ?? null;
---

<Base
	title={data.seoTitle || config?.seo?.title || 'Eens Limited'}
	description={config?.seo?.description ?? 'Warehouses, godowns, business parks, and 3-bedroom apartments across Mlolongo, Syokimau, Baba Dogo, and Thika.'}
>
	<TinaIsland name="page" wrapper={islands.page.wrapper} params={{ slug }} primary>
		<PageBody data={data} slug={slug} />
	</TinaIsland>
</Base>
