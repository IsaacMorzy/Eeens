---
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import PropertyCardFeatured from '../components/blocks/PropertyCardFeatured.astro';
import type { Availability } from '../components/ui/AvailabilityBadge.astro';
import { listProperties, type PropertyNode } from '../lib/data';
import { isPublicProperty } from '../lib/property-visibility';
import { getIllustrationSrc } from '../lib/property-filters';
import { directoryKeyForType } from '../lib/property-directories';

const properties: PropertyNode[] = (await listProperties()).filter(isPublicProperty);
---

<Base title="Saved listings | Eens Business Park" description="Listings you have saved with the heart button, across every category.">
	<Section class="bg-background">
		<div class="mx-auto max-w-5xl">
			<span class="text-[13px] font-medium uppercase tracking-[0.4px] text-primary">Your register</span>
			<h1 class="mt-3 max-w-4xl text-balance font-display text-4xl font-semibold tracking-[-1px] md:text-6xl md:tracking-[-1.8px]">Saved listings.</h1>
			<p class="mt-6 max-w-2xl text-pretty text-lg text-muted-foreground">Listings you saved with the heart button, kept in this browser. Saved listings stay private to your device.</p>
			<p data-saved-status class="mt-4 font-mono text-[13px] text-muted-foreground">0 saved</p>
		</div>
	</Section>

	<Section class="bg-secondary">
		<div class="mx-auto max-w-7xl">
			<div data-saved-empty class="relative max-w-2xl overflow-hidden rounded-xl border border-hairline-steel border-l-4 border-l-primary bg-background p-6 sm:p-8">
				<p class="font-mono text-[12px] text-primary">Saved register</p>
				<h2 class="mt-3 font-display text-2xl font-medium tracking-[-0.4px]">No saved listings yet.</h2>
				<p class="mt-3 text-muted-foreground">Tap the heart on any listing card to keep it here across the four operating zones.</p>
				<div class="mt-6 flex flex-wrap gap-3">
					<Button href="/warehouses" size="lg">Browse warehouses</Button>
					<Button href="/locations" variant="secondary" size="lg">Browse locations</Button>
				</div>
			</div>

			<div data-saved-grid hidden class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{properties.map((property) => {
					const directory = directoryKeyForType(property.type);
					const href = directory && property._sys?.filename ? `/${directory}/${property._sys.filename}` : null;
					if (!href) return null;
					return (
						<div data-saved-card data-saved-href={href} hidden>
							<PropertyCardFeatured
								data={{
									type: property.type ?? null,
									title: property.title ?? null,
									availability: (property.availability as Availability | undefined) ?? null,
									address: property.address ?? null,
									development: property.development ?? null,
									sqft: property.sqft ?? null,
									price: property.price ?? null,
									zone: property.zone ?? null,
									leaseTerm: property.leaseTerm ?? null,
									image: property.heroImage ?? null,
									ref: property._sys?.filename ?? null,
									reference: property.reference ?? null,
									viewLabel: 'View listing',
								}}
								fallbackImageSrc={getIllustrationSrc(property.type)}
							/>
						</div>
					);
				})}
			</div>
		</div>
	</Section>
</Base>

<script>
	import { loadSavedHrefs } from '../lib/saved-listings';

	const cards = [...document.querySelectorAll<HTMLElement>('[data-saved-card]')];
	const grid = document.querySelector<HTMLElement>('[data-saved-grid]');
	const empty = document.querySelector<HTMLElement>('[data-saved-empty]');
	const status = document.querySelector('[data-saved-status]');

	const apply = () => {
		const saved = loadSavedHrefs();
		let visible = 0;
		for (const card of cards) {
			const match = saved.has(card.dataset.savedHref ?? '');
			card.hidden = !match;
			if (match) visible += 1;
		}
		if (grid) grid.hidden = visible === 0;
		if (empty) empty.hidden = visible > 0;
		if (status) status.textContent = `${visible} saved`;
	};

	document.addEventListener('eens:saved-change', apply);
	document.addEventListener('DOMContentLoaded', apply);
	apply();
</script>