---
import Base from '../../layouts/Base.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import PropertyCardFeatured from '../../components/blocks/PropertyCardFeatured.astro';
import type { Availability } from '../../components/ui/AvailabilityBadge.astro';
import { getIllustrationSrc } from '../../lib/property-filters';
import { listProperties, type PropertyNode } from '../../lib/data';
import { filterZoneProperties } from '../../lib/property-directories';

const properties: PropertyNode[] = await listProperties();
const listings = filterZoneProperties(properties, 'Syokimau');
const cardProps = (property: PropertyNode) => ({
  type: property.type ?? null,
  title: property.title ?? null,
  availability: (property.availability as Availability | undefined) ?? null,
  address: property.address ?? null,
  sqft: property.sqft ?? null,
  price: property.price ?? null,
  zone: property.zone ?? null,
  leaseTerm: property.leaseTerm ?? null,
  image: property.heroImage ?? null,
  ref: property._sys?.filename ?? null,
  viewLabel: 'View listing',
});
---

<Base
  title="Syokimau property listings | Eens Business Park"
  description="Published property listings in Syokimau, on the Mombasa Road corridor, with a separate overview for Eens Business Park."
>
  <Section class="bg-background">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <span class="font-mono text-[13px] font-medium uppercase tracking-[0.4px] text-primary">SYOKIMAU</span>
        <h1 class="mt-4 text-balance font-display text-4xl font-semibold tracking-[-1px] md:text-6xl md:tracking-[-1.8px]">Syokimau property listings.</h1>
        <p class="mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-muted-foreground">Syokimau is a location in the Eens operating footprint. Published listings are shown by their recorded type and zone. A Syokimau address does not by itself confirm membership in Eens Business Park.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/business-parks/eens" size="lg">Open park overview</Button>
          <Button href="/contact" variant="secondary" size="lg">Arrange a viewing</Button>
        </div>
      </div>
    </div>
  </Section>

  <Section class="bg-background pt-0">
    <div class="mx-auto max-w-7xl">
      {listings.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {listings.map((property) => <PropertyCardFeatured data={cardProps(property)} fallbackImageSrc={getIllustrationSrc(property.type)} />)}
        </div>
      ) : (
        <div class="max-w-2xl rounded-xl border border-hairline-steel bg-secondary p-8">
          <h2 class="font-display text-2xl font-medium tracking-[-0.4px]">No Syokimau listings are published yet.</h2>
          <p class="mt-3 text-muted-foreground">Contact Eens with the space type and area you are considering. Published inventory will appear here after review.</p>
          <div class="mt-6"><Button href="/contact" size="lg">Ask about availability</Button></div>
        </div>
      )}
    </div>
  </Section>

  <Section class="bg-secondary">
    <div class="mx-auto max-w-6xl">
      <h2 class="font-display text-2xl font-semibold tracking-[-0.4px]">Browse the wider register.</h2>
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href="/warehouses" variant="secondary">Warehouses</Button>
        <Button href="/godowns" variant="secondary">Godowns</Button>
        <Button href="/business-parks/eens" variant="secondary">Eens Business Park</Button>
      </div>
    </div>
  </Section>
</Base>
