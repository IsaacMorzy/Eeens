---
import Base from '../../layouts/Base.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import PropertyCardFeatured from '../../components/blocks/PropertyCardFeatured.astro';
import DirectoryMap from '../../components/blocks/DirectoryMap.astro';
import Icon from '../../components/ui/Icon.astro';
import type { Availability } from '../../components/ui/AvailabilityBadge.astro';
import { contactEmail, getConfig, listProperties, type PropertyNode } from '../../lib/data';
import {
	DIRECTORY_DEFINITIONS,
	filterDirectoryProperties,
	type DirectoryKey,
} from '../../lib/property-directories';
import {
	activeFilterCount,
	applyFilters,
	applySort,
	getIllustrationSrc,
	parseDirectoryFilters,
	parseKva,
	parsePriceKsh,
	parseSortKey,
	parseSqft,
	SORT_OPTIONS,
} from '../../lib/property-filters';
import { selectDirectoryContext } from '../../lib/directory-context';

export function getStaticPaths() {
	return (Object.keys(DIRECTORY_DEFINITIONS) as DirectoryKey[]).map((category) => ({
		params: { category },
		props: { category },
	}));
}

const category = Astro.props.category as DirectoryKey;
const definition = DIRECTORY_DEFINITIONS[category];
const properties: PropertyNode[] = await listProperties();
const allListings = filterDirectoryProperties(properties, category);
const config = (await getConfig()).data?.config ?? null;
const context = selectDirectoryContext(config?.directoryContexts, category);
const contextTitle = context?.title ?? definition.title;
const contextDescription = context?.description ?? definition.description;
const contextHighlights = (context?.highlights ?? []).filter((highlight) => highlight?.label || highlight?.value);
const viewingHref = `mailto:${contactEmail(config)}?subject=${encodeURIComponent(`Ask about ${definition.label}`)}`;
const zoneNames = ['Mlolongo', 'Syokimau', 'Baba Dogo', 'Thika'];
const filters = parseDirectoryFilters(Astro.url.searchParams, zoneNames);
const filteredListings = applySort(applyFilters(allListings, filters), parseSortKey(Astro.url.searchParams.get('sort')));
const sortKey = parseSortKey(Astro.url.searchParams.get('sort'));
const hasPowerFilter = category === 'warehouses' || category === 'godowns' || category === 'business-parks';
const filterCount = activeFilterCount(filters);
const availabilityOptions = [
	{ label: 'Any availability', value: '' },
	{ label: 'For Rent', value: 'ForRent' },
	{ label: 'For Sale', value: 'ForSale' },
	{ label: 'Upcoming', value: 'Upcoming' },
];
---

<Base title={`${definition.label} | Eens Business Park`} description={definition.description}>
	<Section class="bg-background">
		<div class="mx-auto max-w-5xl">
			<span class="text-[13px] font-medium uppercase tracking-[0.4px] text-primary">{definition.label}</span>
			<h1 class="mt-3 max-w-4xl text-balance font-display text-4xl font-semibold tracking-[-1px] md:text-6xl md:tracking-[-1.8px]">
				{definition.title}
			</h1>
			<p class="mt-6 max-w-2xl text-pretty text-lg text-muted-foreground">{definition.description}</p>
			<div class="mt-6 flex flex-wrap items-center gap-3">
				<a href="/locations" class="inline-flex min-h-10 items-center rounded-md border border-hairline-steel px-4 text-sm font-medium text-muted-foreground transition-colors hover:border-primary-hover hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">Browse locations</a>
				<span data-listing-count class="font-mono text-[13px] text-muted-foreground">{filteredListings.length} of {allListings.length} published listing{allListings.length === 1 ? '' : 's'}</span>
			</div>
		</div>
	</Section>

	<nav aria-label="Property directories" class="border-y border-hairline-steel/50 bg-secondary">
		<div class="mx-auto flex max-w-7xl gap-2 overflow-x-auto px-4 py-3 sm:px-6 lg:px-8">
			{Object.values(DIRECTORY_DEFINITIONS).map((directory) => (
				<a
					href={`/${directory.key}`}
					aria-current={directory.key === category ? 'page' : undefined}
					class="inline-flex min-h-10 shrink-0 items-center rounded-md border border-transparent px-3 text-sm text-muted-foreground transition-[border-color,color,background-color] hover:border-hairline-steel hover:bg-background hover:text-foreground aria-[current=page]:border-primary/60 aria-[current=page]:bg-background aria-[current=page]:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50"
				>
					{directory.label}
				</a>
			))}
		</div>
	</nav>

	<Section class="bg-secondary">
		<div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-start">
			<div>
				<p class="font-mono text-[12px] uppercase tracking-[0.4px] text-primary">Directory context</p>
				<h2 class="mt-3 max-w-xl font-display text-3xl font-semibold tracking-[-0.6px]">{contextTitle}</h2>
				<p class="mt-4 max-w-2xl text-muted-foreground">{contextDescription}</p>
				{context?.zoneLabel && <p class="mt-4 font-mono text-[12px] text-primary">{context.zoneLabel}</p>}
				<div class="mt-5 flex flex-wrap gap-3">
					<Button href={context?.primaryActionLink ?? '/locations'} size="lg">{context?.primaryActionLabel ?? 'Browse locations'}</Button>
					<Button href={viewingHref} variant="secondary" size="lg">Arrange a viewing</Button>
				</div>
			</div>
			{contextHighlights.length > 0 && (
				<dl class="grid gap-px overflow-hidden rounded-xl border border-hairline-steel bg-hairline-steel sm:grid-cols-2">
					{contextHighlights.map((highlight) => (
						<div class="bg-background p-5">
							<dt class="font-mono text-[12px] uppercase tracking-[0.4px] text-muted-foreground">{highlight?.label}</dt>
							<dd class="mt-2 font-display text-lg font-medium text-foreground">{highlight?.value}</dd>
						</div>
					))}
				</dl>
			)}
		</div>
	</Section>

	<Section class="bg-background">
		<div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:items-start">
			<DirectoryMap pathname={Astro.url.pathname} label={context?.mapLabel ?? 'Operating zones'} />
			<div id="published-listings">
					<header class="mb-6 flex flex-wrap items-end justify-between gap-4">
						<div>
							<p class="font-mono text-[12px] uppercase tracking-[0.4px] text-primary">Register</p>
							<h2 class="mt-2 font-display text-2xl font-semibold tracking-[-0.4px]">Published {definition.label.toLowerCase()}</h2>
						</div>
						<div class="flex flex-wrap items-center gap-4">
							<span data-result-status class="font-mono tabular-nums text-[13px] text-muted-foreground">{filterCount ? `${filteredListings.length} match${filteredListings.length === 1 ? '' : 'es'}` : `${allListings.length} record${allListings.length === 1 ? '' : 's'}`}</span>
						<label class="grid gap-1.5 text-sm font-medium" for={`sort-${category}`}>
							<span class="sr-only">Sort listings</span>
							<select id={`sort-${category}`} name="sort" form="directory-filters-form" class="h-10 rounded-md border border-hairline-steel bg-background px-3 text-[13px] text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring/50">
									{SORT_OPTIONS.map((option) => <option value={option.value} selected={sortKey === option.value}>{option.label}</option>)}
								</select>
							</label>
						</div>
					</header>

				<form id="directory-filters-form" data-directory-filters class="mb-8 rounded-xl border border-hairline-steel bg-secondary p-4 sm:p-5" method="get">
					<div class="flex flex-wrap items-end gap-4">
						<label class="grid min-w-40 flex-1 gap-2 text-sm font-medium" for={`zone-${category}`}>
							<span>Zone</span>
							<select id={`zone-${category}`} name="zone" class="h-11 rounded-md border border-hairline-steel bg-background px-3 text-sm text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring/50">
								<option value="">All zones</option>
								{zoneNames.map((zone) => <option value={zone} selected={filters.zone === zone}>{zone}</option>)}
							</select>
						</label>
						<div class="grid min-w-40 flex-1 gap-2 text-sm font-medium">
							<span>Availability</span>
							<div data-availability-toggle class="grid grid-cols-4 gap-1 rounded-md border border-hairline-steel bg-background p-1">
								{availabilityOptions.map((option) => (
									<label class="cursor-pointer">
										<input type="radio" name="availability" value={option.value} checked={filters.availability === option.value} class="peer sr-only" />
										<span class="flex h-9 items-center justify-center rounded-[4px] px-2 text-[13px] font-medium text-muted-foreground transition-[background-color,color] peer-checked:bg-action peer-checked:text-action-foreground peer-focus-visible:ring-2 peer-focus-visible:ring-ring/50 hover:text-foreground">{option.label}</span>
									</label>
								))}
							</div>
						</div>
						<label class="grid min-w-40 flex-1 gap-2 text-sm font-medium" for={`area-${category}`}>
							<span>Minimum area</span>
							<select id={`area-${category}`} name="minSqft" class="h-11 rounded-md border border-hairline-steel bg-background px-3 text-sm text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring/50">
								<option value="">Any published area</option>
								<option value="4000" selected={filters.minSqft === 4000}>4,000 sq ft+</option>
								<option value="9000" selected={filters.minSqft === 9000}>9,000 sq ft+</option>
								<option value="18000" selected={filters.minSqft === 18000}>18,000 sq ft+</option>
							</select>
						</label>
						{hasPowerFilter && (
							<label class="grid min-w-40 flex-1 gap-2 text-sm font-medium" for={`power-${category}`}>
								<span>Minimum power</span>
								<select id={`power-${category}`} name="minKva" class="h-11 rounded-md border border-hairline-steel bg-background px-3 text-sm text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring/50">
									<option value="">Any published power</option>
									<option value="50" selected={filters.minKva === 50}>50 kVA+</option>
									<option value="200" selected={filters.minKva === 200}>200 kVA+</option>
								</select>
							</label>
						)}
						<label class="flex items-end pb-0.5" title="Show only listings you have saved with the heart button">
							<input type="checkbox" data-saved-only class="peer sr-only" />
							<span class="flex h-11 items-center gap-1.5 rounded-md border border-hairline-steel bg-background px-3 text-[13px] font-medium text-muted-foreground transition-[background-color,color,border-color] peer-checked:border-action peer-checked:bg-action peer-checked:text-action-foreground peer-focus-visible:ring-2 peer-focus-visible:ring-ring/50 hover:text-foreground"><Icon name="heart" class="size-3.5" aria-hidden="true" />Saved <span data-saved-count class="font-mono tabular-nums">0</span></span>
						</label>
						<button type="submit" class="inline-flex h-11 items-center justify-center rounded-md bg-action px-5 text-sm font-medium text-action-foreground transition-[background-color,transform] hover:bg-action-hover motion-safe:active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">Filter listings</button>
						<a href={Astro.url.pathname} class="inline-flex h-11 items-center px-2 text-sm font-medium text-muted-foreground underline-offset-4 hover:text-foreground hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">Reset</a>
					</div>
					<p class="mt-3 font-mono text-[12px] text-muted-foreground">Filters use published area, power, zone, and availability facts only.</p>
				</form>

				{allListings.length > 0 ? (					<div data-listing-grid class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{filteredListings.map((property) => (
							<div data-directory-card data-zone={property.zone ?? ''} data-sqft={parseSqft(property.sqft)} data-kva={parseKva(property)} data-availability={property.availability ?? ''} data-price={parsePriceKsh(property)} data-date={property.publishedDate ?? ''} data-href={`/${category}/${property._sys?.filename ?? ''}`}>
								<PropertyCardFeatured
									data={{
										type: property.type ?? null,
										title: property.title ?? null,
										availability: (property.availability as Availability | undefined) ?? null,
										address: property.address ?? null,
										development: property.development ?? null,
										sqft: property.sqft ?? null,
										price: property.price ?? null,
										zone: property.zone ?? null,
										leaseTerm: property.leaseTerm ?? null,
										image: property.heroImage ?? null,
										ref: property._sys?.filename ?? null,
										reference: property.reference ?? null,
										viewLabel: category === 'shops' ? 'View shop' : 'View listing',
									}}
									fallbackImageSrc={getIllustrationSrc(property.type)}
								/>
							</div>
						))}
					</div>
				) : (
					<div class="relative max-w-2xl overflow-hidden rounded-xl border border-hairline-steel border-l-4 border-l-primary bg-secondary p-6 sm:p-8">
						<p class="font-mono text-[12px] text-primary">Register status</p>
						<h2 class="mt-3 font-display text-2xl font-medium tracking-[-0.4px]">{definition.emptyTitle}</h2>
						<p class="mt-3 text-muted-foreground">{definition.emptyDescription}</p>
						<div class="mt-6 flex flex-wrap gap-3">
							<Button href={viewingHref} size="lg">Ask about availability</Button>
							<Button href="/locations" variant="secondary" size="lg">Browse locations</Button>
						</div>
					</div>
				)}
				<div data-filter-empty hidden={!(filterCount > 0 && filteredListings.length === 0)} class="mt-6 relative max-w-2xl overflow-hidden rounded-xl border border-hairline-steel border-l-4 border-l-primary bg-secondary p-6 sm:p-8">
					<p class="font-mono text-[12px] text-primary">Filtered register</p>
					<h2 class="mt-3 font-display text-2xl font-medium tracking-[-0.4px]">No published records match these filters.</h2>
					<p class="mt-3 text-muted-foreground">Clear a filter or ask the office about the next verified listing.</p>
					<div class="mt-6 flex flex-wrap gap-3">
						<Button href={viewingHref} size="lg">Ask about availability</Button>
						<a href={Astro.url.pathname} class="inline-flex min-h-11 items-center rounded-md border border-hairline-steel px-5 text-sm font-medium text-foreground hover:border-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50">Clear filters</a>
					</div>
				</div>
			</div>
		</div>
	</Section>

	<Section class="bg-secondary">
		<div class="mx-auto flex max-w-5xl flex-col items-start justify-between gap-6 md:flex-row md:items-center">
			<div>
				<h2 class="font-display text-3xl font-semibold tracking-[-0.6px]">Arrange a viewing.</h2>
				<p class="mt-3 max-w-xl text-muted-foreground">Send the listing reference or tell us which category and zone you are considering.</p>
			</div>
			<Button href={viewingHref} size="lg">Arrange a viewing</Button>
		</div>
	</Section>
</Base>

<script>
	import { loadSavedHrefs } from '../../lib/saved-listings';

	const root = document.querySelector('[data-directory-filters]')?.closest('#published-listings');
	const form = root?.querySelector('[data-directory-filters]') as HTMLFormElement | null;
	const grid = root?.querySelector<HTMLElement>('[data-listing-grid]');
	const cards = root ? [...root.querySelectorAll<HTMLElement>('[data-directory-card]')] : [];
	const count = document.querySelector('[data-listing-count]');
	const status = root?.querySelector('[data-result-status]');
	const empty = root?.querySelector('[data-filter-empty]') as HTMLElement | null;
	const savedOnlyInput = root?.querySelector<HTMLInputElement>('[data-saved-only]') ?? null;
	const savedCount = root?.querySelector('[data-saved-count]') ?? null;
	const params = new URLSearchParams(window.location.search);

	if (root && form && grid && cards.length) {
		const zones = new Set(['Mlolongo', 'Syokimau', 'Baba Dogo', 'Thika']);
		const sqftTiers = new Set([4000, 9000, 18000]);
		const kvaTiers = new Set([50, 200]);
		const availabilityValues = new Set(['ForRent', 'ForSale', 'Upcoming']);
		const sortValues = new Set(['featured', 'price-desc', 'price-asc', 'area-desc', 'newest']);
		const validTier = (value: string | null, tiers: Set<number>) => {
			const parsed = Number(value);
			return value && tiers.has(parsed) ? parsed : 0;
		};
		const rawZone = params.get('zone');
		const rawAvailability = params.get('availability');
		const rawSort = params.get('sort');
		const values = {
			zone: rawZone && zones.has(rawZone) ? rawZone : '',
			minSqft: validTier(params.get('minSqft'), sqftTiers),
			minKva: validTier(params.get('minKva'), kvaTiers),
			availability: rawAvailability && availabilityValues.has(rawAvailability) ? rawAvailability : '',
			sort: rawSort && sortValues.has(rawSort) ? rawSort : 'featured',
			savedOnly: Boolean(savedOnlyInput?.checked),
		};
		const select = (name: string): HTMLSelectElement | HTMLInputElement | null => root.querySelector(`[name="${name}"]`);
		const sortField = select('sort');
		const applyInitialValues = () => {
			for (const [name, value] of Object.entries(values)) {
				const field = select(name);
				if (!field) continue;
				if (field instanceof HTMLSelectElement) {
					if (value) field.value = String(value);
				} else if (field instanceof HTMLInputElement && field.type === 'radio') {
					const radio = form.querySelector<HTMLInputElement>(`[name="${name}"][value="${value}"]`);
					if (radio) radio.checked = true;
				}
			}
		};
		applyInitialValues();
		const reorder = (visible: HTMLElement[]) => {
			if (values.sort === 'featured' || visible.length < 2) return;
			const price = (card: HTMLElement) => Number(card.dataset.price ?? 0);
			const area = (card: HTMLElement) => Number(card.dataset.sqft ?? 0);
			const date = (card: HTMLElement) => {
				const t = Date.parse(card.dataset.date ?? '');
				return Number.isNaN(t) ? 0 : t;
			};
			const by = (a: HTMLElement, b: HTMLElement): number => {
				if (values.sort === 'price-desc') return price(b) - price(a);
				if (values.sort === 'price-asc') return price(a) - price(b);
				if (values.sort === 'area-desc') return area(b) - area(a);
				if (values.sort === 'newest') return date(b) - date(a);
				return 0;
			};
			visible.sort(by);
			for (const card of visible) grid.append(card);
		};
		const apply = () => {
			const saved = loadSavedHrefs();
			const savedInRegister = cards.filter((card) => saved.has(card.dataset.href ?? '')).length;
			if (savedCount) savedCount.textContent = String(savedInRegister);
			if (savedOnlyInput) values.savedOnly = savedOnlyInput.checked;
			const visible: HTMLElement[] = [];
			for (const card of cards) {
				const match = (!values.zone || card.dataset.zone === values.zone)
					&& (!values.minSqft || Number(card.dataset.sqft) >= values.minSqft)
					&& (!values.minKva || Number(card.dataset.kva) >= values.minKva)
					&& (!values.availability || card.dataset.availability === values.availability)
					&& (!values.savedOnly || saved.has(card.dataset.href ?? ''));
				card.hidden = !match;
				if (match) visible.push(card);
			}
			reorder(visible);
			const active = Boolean(values.zone || values.minSqft || values.minKva || values.availability || values.savedOnly);
			if (count) count.textContent = `${visible.length} of ${cards.length} published listing${cards.length === 1 ? '' : 's'}`;
			if (status) status.textContent = active ? `${visible.length} match${visible.length === 1 ? '' : 'es'}` : `${cards.length} record${cards.length === 1 ? '' : 's'}`;
			if (empty) empty.hidden = !active || visible.length > 0;
		};
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const next = new URLSearchParams();
			for (const [key, value] of new FormData(form).entries()) {
				if (typeof value === 'string' && value) next.set(key, value);
			}
			if (sortField && sortField.value !== 'featured') next.set('sort', sortField.value);
			window.history.pushState({}, '', `${window.location.pathname}${next.toString() ? `?${next}` : ''}`);
			values.zone = next.get('zone') ?? '';
			values.minSqft = Number(next.get('minSqft') ?? 0);
			values.minKva = Number(next.get('minKva') ?? 0);
			values.availability = next.get('availability') ?? '';
			values.sort = next.get('sort') ?? 'featured';
			apply();
		});
		savedOnlyInput?.addEventListener('change', apply);
		document.addEventListener('eens:saved-change', apply);
		sortField?.addEventListener('change', () => {
			values.sort = (sortField as HTMLSelectElement).value;
			apply();
		});
		window.addEventListener('popstate', () => window.location.reload());
		apply();
	}
</script>
